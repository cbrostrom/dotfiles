<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dk.brostrom.cloudcli-sessions</string>

    <key>ProgramArguments</key>
    <array>
        <string>__DOTFILES_DIR__/scripts/cloudcli-sessions-cleanup.sh</string>
        <string>purge</string>
        <string>--older-than</string>
        <string>5</string>
        <string>--yes</string>
    </array>

    <!-- Daily 04:00 — purge sessions older than 5 days -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/cloudcli-sessions-cleanup.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/cloudcli-sessions-cleanup.err.log</string>
</dict>
</plist>

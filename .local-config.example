# Optional machine-local shell overrides.
# Copy to ~/.local-config only when a host needs values not represented by its
# Stow profile. This file is not tracked after copying.

MACHINE_NAME="my-workstation"

# Optional Zellij layout: dev | shopify | agent | ops | vps | default
# ZJ_DEFAULT_LAYOUT="dev"

# Free-form host notes for local scripts.
# NOTES=""

// Zed keymap — https://zed.dev/docs/key-bindings
//
// Leader: <space> in vim normal mode
//
// Quick reference:
//   space g s    git: status (lazygit)
//   space g m    git: merge branch into current (fzf)
//   space g M    git: merge --no-ff
//   space g a    git: abort merge
//   space g c    git: checkout (fzf)
//   space g n    git: new branch
//   space g p    git: panel
//   space g P    git: push
//   space g U    git: push -u origin HEAD
//   space g l    git: pull --rebase
//   space g f    git: fetch --all --prune
//   space g S    git: stash push -m
//   space g O    git: stash pop (fzf)
//   space g L    git: log graph
//   space h c    gh: pr create --fill
//   space h v    gh: pr view --web
//   space h w    gh: pr checks --watch
//   space h r    gh: repo view --web
//   space d b    dotfiles: bootstrap
//   space d d    dotfiles: zed-diff-base
//   space d i    dotfiles: install zed-config
//   space r g    rtk: gain
//   space r h    rtk: gain --history
//   space r d    rtk: discover
//   space f f    file finder
//   space f g    project search
//   space f r    recent projects
//   space s      outline (symbols)
//   space q      close active item
//   space t      terminal toggle
//   space p      command palette
//   space e      project panel
//   space x      diagnostics
//   space w v    split right
//   space w s    split down
//   space w c    close pane
//   space b n/p  next/prev buffer
//   space b d    close buffer
[
  {
    "context": "Workspace",
    "bindings": {
      "shift shift": "command_palette::Toggle",
      "ctrl ctrl": "file_finder::Toggle",
      "cmd-shift-m": [
        "task::Spawn",
        { "task_name": "git: merge branch into current" },
      ],

      // Panels
      "cmd-shift-e": "project_panel::ToggleFocus",
      "cmd-shift-g": "git_panel::ToggleFocus",

      // Pane navigation
      "ctrl-h": ["workspace::ActivatePaneInDirection", "Left"],
      "ctrl-j": ["workspace::ActivatePaneInDirection", "Down"],
      "ctrl-k": ["workspace::ActivatePaneInDirection", "Up"],
      "ctrl-l": ["workspace::ActivatePaneInDirection", "Right"],
    },
  },
  {
    // Vim normal/visual leader chords. Only fire when not typing a count
    // or operator-pending — vim_operator == "none" guards against e.g.
    // pressing `d<space>` consuming the leader chord.
    "context": "Editor && vim_mode == normal && !VimWaiting",
    "bindings": {
      // git
      "space g s": ["task::Spawn", { "task_name": "git: status (lazygit)" }],
      "space g m": [
        "task::Spawn",
        { "task_name": "git: merge branch into current" },
      ],
      "space g shift-m": [
        "task::Spawn",
        { "task_name": "git: merge --no-ff branch into current" },
      ],
      "space g a": ["task::Spawn", { "task_name": "git: abort merge" }],
      "space g c": ["task::Spawn", { "task_name": "git: checkout (fzf)" }],
      "space g n": ["task::Spawn", { "task_name": "git: new branch" }],
      "space g shift-p": ["task::Spawn", { "task_name": "git: push" }],
      "space g shift-u": [
        "task::Spawn",
        { "task_name": "git: push -u origin HEAD" },
      ],
      "space g l": ["task::Spawn", { "task_name": "git: pull --rebase" }],
      "space g f": ["task::Spawn", { "task_name": "git: fetch --all --prune" }],
      "space g shift-s": ["task::Spawn", { "task_name": "git: stash push -m" }],
      "space g shift-o": [
        "task::Spawn",
        { "task_name": "git: stash pop (fzf)" },
      ],
      "space g shift-l": ["task::Spawn", { "task_name": "git: log graph" }],

      // gh
      "space h c": ["task::Spawn", { "task_name": "gh: pr create --fill" }],
      "space h v": ["task::Spawn", { "task_name": "gh: pr view --web" }],
      "space h w": ["task::Spawn", { "task_name": "gh: pr checks --watch" }],
      "space h r": ["task::Spawn", { "task_name": "gh: repo view --web" }],

      // dotfiles
      "space d b": ["task::Spawn", { "task_name": "dotfiles: bootstrap" }],
      "space d d": ["task::Spawn", { "task_name": "dotfiles: zed-diff-base" }],
      "space d i": [
        "task::Spawn",
        { "task_name": "dotfiles: install zed-config" },
      ],

      // rtk
      "space r g": ["task::Spawn", { "task_name": "rtk: gain" }],
      "space r h": ["task::Spawn", { "task_name": "rtk: gain --history" }],
      "space r d": ["task::Spawn", { "task_name": "rtk: discover" }],

      // find / nav
      "space f f": "file_finder::Toggle",
      "space f g": "pane::DeploySearch",
      "space f r": "projects::OpenRecent",

      // panels
      "space e": "project_panel::ToggleFocus",
      "space g p": "git_panel::ToggleFocus",
      "space x": "diagnostics::Deploy",

      // splits
      "space w v": "pane::SplitRight",
      "space w s": "pane::SplitDown",
      "space w c": "pane::CloseActiveItem",
      "space w =": "workspace::ActivateNextPane",

      // buffers
      "space b n": "pane::ActivateNextItem",
      "space b p": "pane::ActivatePrevItem",
      "space b d": "pane::CloseActiveItem",

      // misc
      "space s": "outline::Toggle",
      "space q": "pane::CloseActiveItem",
      "space t": "workspace::ToggleBottomDock",
      "space p": "command_palette::Toggle",
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "j k": "vim::NormalBefore",
    },
  },
]

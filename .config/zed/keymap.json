// Zed keymap — https://zed.dev/docs/key-bindings
//
// Leader: alt alt (no modal mode — vim is disabled)
//
// Quick reference:
//   alt alt g s    git: status (lazygit)
//   alt alt g m    git: merge branch into current (fzf)
//   alt alt g M    git: merge --no-ff
//   alt alt g a    git: abort merge
//   alt alt g c    git: checkout (fzf)
//   alt alt g n    git: new branch
//   alt alt g P    git: push
//   alt alt g U    git: push -u origin HEAD
//   alt alt g l    git: pull --rebase
//   alt alt g f    git: fetch --all --prune
//   alt alt g S    git: stash push -m
//   alt alt g O    git: stash pop (fzf)
//   alt alt g L    git: log graph
//   alt alt h c    gh: pr create --fill
//   alt alt h v    gh: pr view --web
//   alt alt h w    gh: pr checks --watch
//   alt alt h r    gh: repo view --web
//   alt alt d b    dotfiles: bootstrap
//   alt alt d d    dotfiles: zed-diff-base
//   alt alt d i    dotfiles: install zed-config
//   alt alt r g    rtk: gain
//   alt alt r h    rtk: gain --history
//   alt alt r d    rtk: discover
//   alt alt f f    file finder
//   alt alt f g    project search (grep)
//   alt alt f r    recent projects
//   alt alt p e    panel: project (explorer)
//   alt alt p g    panel: git
//   alt alt p t    panel: terminal
//   alt alt p x    panel: diagnostics (eXamine)
//   alt alt p o    panel: outline
//   alt alt p a    panel: agent
//   alt alt p c    panel: collaboration
//   alt alt p p    panel: command palette
//   alt alt s      outline (symbols) — quick access
//   alt alt q      close active item
//   alt alt w v    split right
//   alt alt w s    split down
//   alt alt w c    close pane
//   alt alt b n/p  next/prev buffer
//   alt alt b d    close buffer
//
// Direct bindings (always active):
//   shift shift      command palette
//   ctrl-h/j/k/l     pane navigation
//   cmd-shift-e      project panel
//   cmd-shift-g      git panel
[
    {
        "context": "Workspace",
        "bindings": {
            "shift shift": "command_palette::Toggle",

            "cmd-shift-m": [
                "task::Spawn",
                { "task_name": "git: merge branch into current" }
            ],

            // Direct panel shortcuts
            "cmd-shift-e": "project_panel::ToggleFocus",
            "cmd-shift-g": "git_panel::ToggleFocus",

            // Pane navigation
            "ctrl-h": "workspace::ActivatePaneLeft",
            "ctrl-j": "workspace::ActivatePaneDown",
            "ctrl-k": "workspace::ActivatePaneUp",
            "ctrl-l": "workspace::ActivatePaneRight",

            // ─── Leader: alt alt ───────────────────────────────────────────────

            // git
            "alt alt g s": [
                "task::Spawn",
                { "task_name": "git: status (lazygit)" }
            ],
            "alt alt g m": [
                "task::Spawn",
                { "task_name": "git: merge branch into current" }
            ],
            "alt alt g M": [
                "task::Spawn",
                { "task_name": "git: merge --no-ff branch into current" }
            ],
            "alt alt g a": ["task::Spawn", { "task_name": "git: abort merge" }],
            "alt alt g c": [
                "task::Spawn",
                { "task_name": "git: checkout (fzf)" }
            ],
            "alt alt g n": ["task::Spawn", { "task_name": "git: new branch" }],
            "alt alt g P": ["task::Spawn", { "task_name": "git: push" }],
            "alt alt g U": [
                "task::Spawn",
                { "task_name": "git: push -u origin HEAD" }
            ],
            "alt alt g l": [
                "task::Spawn",
                { "task_name": "git: pull --rebase" }
            ],
            "alt alt g f": [
                "task::Spawn",
                { "task_name": "git: fetch --all --prune" }
            ],
            "alt alt g S": [
                "task::Spawn",
                { "task_name": "git: stash push -m" }
            ],
            "alt alt g O": [
                "task::Spawn",
                { "task_name": "git: stash pop (fzf)" }
            ],
            "alt alt g L": ["task::Spawn", { "task_name": "git: log graph" }],

            // gh
            "alt alt h c": [
                "task::Spawn",
                { "task_name": "gh: pr create --fill" }
            ],
            "alt alt h v": [
                "task::Spawn",
                { "task_name": "gh: pr view --web" }
            ],
            "alt alt h w": [
                "task::Spawn",
                { "task_name": "gh: pr checks --watch" }
            ],
            "alt alt h r": [
                "task::Spawn",
                { "task_name": "gh: repo view --web" }
            ],

            // dotfiles
            "alt alt d b": [
                "task::Spawn",
                { "task_name": "dotfiles: bootstrap" }
            ],
            "alt alt d d": [
                "task::Spawn",
                { "task_name": "dotfiles: zed-diff-base" }
            ],
            "alt alt d i": [
                "task::Spawn",
                { "task_name": "dotfiles: install zed-config" }
            ],

            // rtk
            "alt alt r g": ["task::Spawn", { "task_name": "rtk: gain" }],
            "alt alt r h": [
                "task::Spawn",
                { "task_name": "rtk: gain --history" }
            ],
            "alt alt r d": ["task::Spawn", { "task_name": "rtk: discover" }],

            // find / nav
            "alt alt f f": "file_finder::Toggle",
            "alt alt f g": "project_search::ToggleFocus",
            "alt alt f r": "projects::OpenRecent",

            // panels — alt alt p <letter>
            "alt alt p e": "project_panel::ToggleFocus",
            "alt alt p g": "git_panel::ToggleFocus",
            "alt alt p t": "terminal_panel::ToggleFocus",
            "alt alt p x": "diagnostics::Deploy",
            "alt alt p o": "outline::Toggle",
            "alt alt p a": "agent::ToggleFocus",
            "alt alt p c": "collab_panel::ToggleFocus",
            "alt alt p p": "command_palette::Toggle",

            // splits
            "alt alt w v": "pane::SplitRight",
            "alt alt w s": "pane::SplitDown",
            "alt alt w c": "pane::CloseActiveItem",
            "alt alt w =": "workspace::ActivateNextPane",

            // buffers
            "alt alt b n": "pane::ActivateNextItem",
            "alt alt b p": "pane::ActivatePreviousItem",
            "alt alt b d": "pane::CloseActiveItem",

            // misc
            "alt alt s": "outline::Toggle",
            "alt alt q": "pane::CloseActiveItem"
        }
    }
]

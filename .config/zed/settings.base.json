// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// Machine-specific config (Higgins/kb MCP, wsl_connections on macOS, ollama, font sizes, etc.)
// → see settings.local.example.json and add manually per machine
{
    "redact_private_values": true,
    "context_servers": {
    },
    "auto_install_extensions": {
        "astro": true,
        "colored-zed-icons-theme": true,
        "csv": true,
        "dockerfile": true,
        "git-firefly": true,
        "github-actions": true,
        "github-activity-summarizer": true,
        "graphql": true,
        "html": true,
        "ini": true,
        "liquid": true,
        "mcp-server-github": true,
        "mcp-server-shopify-dev": true,
        "nix": true,
        "toml": true,
        "yaml": true,
        "tailwind-css": true
    },
    "git_panel": {
        "dock": "left",
        "button": true,
        "tree_view": true
    },
    "edit_predictions": {
        "mode": "subtle",
        "provider": "copilot"
    },
    "agent": {
        "default_profile": "write",
        "tool_permissions": {
            "tools": {
                "terminal": {
                    "always_allow": [
                        { "pattern": "^npx\\s+skills(\\s|$)" },
                        { "pattern": "^echo\\s+skills(\\s|$)" },
                        { "pattern": "^cat\\b" },
                        { "pattern": "^python3\\b" },
                        { "pattern": "^dir\\s+/s(\\s|$)" }
                    ]
                },
                "fetch": {
                    "always_allow": [
                        { "pattern": "^https?://github\\.com" },
                        { "pattern": "^https?://zed\\.dev" }
                    ]
                }
            }
        },
        "button": true,
        "default_model": {
            "provider": "copilot_chat",
            "model": "claude-sonnet-4.6",
            "effort": "high",
            "enable_thinking": true
        },
        "enable_feedback": true,
        "flexible": false,
        "dock": "right",
        "sidebar_side": "right",
        "favorite_models": [
            {
                "provider": "copilot_chat",
                "model": "claude-sonnet-4.6",
                "enable_thinking": true,
                "effort": "high"
            }
        ],
        "model_parameters": [],
        "show_turn_stats": true
    },
    "agent_servers": {
        "claude-acp": {
            "type": "registry",
            "favorite_config_option_values": {
                "model": ["claude-sonnet-4-6", "default"],
                "mode": ["auto", "plan", "bypassPermissions"]
            },
            "default_config_options": {
                "model": "claude-sonnet-4-6",
                "mode": "auto"
            }
        },
        "github-copilot-cli": {
            "type": "registry"
        }
    },
    "wsl_connections": [
        {
            "distro_name": "Debian",
            "user": null,
            "projects": [
                { "paths": ["/home/christian"] },
                { "paths": ["/home/christian/Projects"] },
                { "paths": ["/home/christian/Projects/huskr"] },
                { "paths": ["/home/christian/Projects/laesr"] },
                { "paths": ["/home/christian/Work/Fiskars/stellar-shopify"] }
            ]
        }
    ],
    "which_key": {
        "enabled": false
    },
    "text_rendering_mode": "platform_default",
    "ui_font_family": ".ZedSans",
    "telemetry": {
        "diagnostics": false,
        "metrics": false
    },
    "when_closing_with_no_tabs": "keep_window_open",
    "session": {
        "trust_all_worktrees": true
    },
    "terminal": {
        "cursor_shape": "bar",
        "max_scroll_history_lines": 5000
    },
    "project_panel": {
        "diagnostic_badges": true,
        "git_status_indicator": true,
        "bold_folder_labels": true,
        "dock": "left",
        "auto_fold_dirs": false
    },
    "minimap": {
        "show": "auto"
    },
    "cursor_shape": "bar",
    "cursor_blink": true,
    "buffer_font_fallbacks": ["JetBrains Mono", "Fira Code", "Consolas", "monospace"],
    "buffer_font_family": "JetBrainsMono Nerd Font",
    "file_types": {
        "tailwindcss": ["*.css"]
    },
    "tab_bar": {
        "show": true
    },
    "max_tabs": 10,
    "autosave": "on_focus_change",
    "colorize_brackets": true,
    "linked_edits": true,
    "show_whitespaces": "boundary",
    "indent_guides": {
        "enabled": true
    },
    "soft_wrap": "none",
    "hard_tabs": false,
    "tab_size": 2,
    "vim_mode": false,
    "auto_indent_on_paste": false,
    "use_on_type_format": false,
    "base_keymap": "VSCode",
    "icon_theme": {
        "mode": "dark",
        "light": "Zed (Default)",
        "dark": "Colored Zed Icons Theme Dark"
    },
    "ui_font_size": 16,
    "buffer_font_size": 14.0,
    "theme": {
        "mode": "dark",
        "light": "Ayu Dark",
        "dark": "Ayu Dark"
    },
    "proxy": ""
}

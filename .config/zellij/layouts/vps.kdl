// vps layout — superbro VPS server overview (no GUI tools)
layout {
    tab name="vps" focus=true {
        pane split_direction="horizontal" {
            pane split_direction="vertical" {
                pane name="top"   command="htop"
                pane name="ufw"   command="watch" { args "-n" "5" "sudo" "ufw" "status" "numbered"; }
            }
            pane split_direction="vertical" {
                pane name="fail2ban" command="watch" { args "-n" "10" "sudo" "fail2ban-client" "status"; }
                pane name="journal"  command="journalctl" { args "-fxe" "--no-pager"; }
            }
        }
    }
    tab name="shell" { pane; }
    pane size=1 borderless=true { plugin location="zellij:tab-bar"; }
    pane size=2 borderless=true { plugin location="zellij:status-bar"; }
}

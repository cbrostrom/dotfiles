{
  "mcpServers": {
    "mcporter": {
      "command": "npx",
      "args": ["mcporter", "serve", "--stdio"],
      "env": {
        "MCPORTER_CONFIG": "${HOME}/.mcporter/mcporter.json"
      }
    },
    "atlassian": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v1/mcp/authv2"
    }
  }
}

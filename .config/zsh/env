# Node/Web development environment
export NODE_OPTIONS="--max-old-space-size=8192"
# PNPM_HOME is set in .zshrc with OS detection

# Environment variables for modern tools
export BAT_THEME="TwoDark"
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git --exclude node_modules'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"

# Go environment
export GOPATH="$HOME/go"

# ASDF version manager
if [[ -f "$HOME/.asdf/asdf.sh" ]]; then
    . "$HOME/.asdf/asdf.sh"
    # Load completions only if they exist and we're in zsh
    if [[ -n "$ZSH_VERSION" ]] && [[ -f "$HOME/.asdf/completions/asdf.zsh" ]]; then
        . "$HOME/.asdf/completions/asdf.zsh"
    fi
fi

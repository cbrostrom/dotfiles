{
  "editor.formatOnSave": true,
  "workbench.colorCustomizations": {},
  "vscodeGitCommit.variables": {
    "prefix": "keke",
  },
  "colorize.languages": [
    "javascript",
    "shellscript",
    "typescriptreact",
    "typescript",
  ],
  "security.workspace.trust.untrustedFiles": "open",
  "redhat.telemetry.enabled": false,
  "editor.fontFamily": "'Hack Nerd Font Mono', Monaco, 'Courier New', monospace",
  "git.enableSmartCommit": true,
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "git.confirmSync": false,
  "tailwind-fold.autoFold": false,
  "tailwind-fold.foldStyle": "QUOTES",
  "tailwind-fold.unfoldIfLineSelected": true,
  "tailwind-fold.unfoldedTextOpacity": 0.7,
  "tailwind-fold.supportedLanguages": [
    "ts",
    "tsx",
    "html",
    "js",
    "jsx",
    "liquid",
    "handlebars",
    "cshtml",
  ],
  "typescript.updateImportsOnFileMove.enabled": "always",
  "typescript.inlayHints.parameterNames.enabled": "all",
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll": "always",
    },
    "editor.formatOnSave": true,
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll": "always",
    },
    "editor.formatOnSave": true,
  },
  "workbench.startupEditor": "none",
  "javascript.updateImportsOnFileMove.enabled": "always",
  "[astro]": {
    "editor.defaultFormatter": "astro-build.astro-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll": "always",
    },
    "editor.formatOnSave": true,
  },
  "editor.formatOnPaste": true,
  "editor.formatOnType": true,
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "astro",
    "typescript",
    "typescriptreact",
  ],
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[liquid]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
  },
  "terminal.external.windowsExec": "C:\\Windows\\System32\\wsl.exe",
  "[lua]": {
    "editor.defaultFormatter": "yinfei.luahelper",
  },
  "typescript.tsserver.nodePath": "node",
  "terminal.integrated.cursorStyleInactive": "line",
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.defaultProfile.windows": "Debian",
  "tailwindCSS.emmetCompletions": true,
  "tailwindCSS.experimental.configFile": null,
  "tailwindCSS.experimental.classRegex": [],
  "editor.quickSuggestions": {
    "strings": "on",
  },
  "files.associations": {
    "*.css": "tailwindcss",
  },
  "projectManager.filterOnFullPath": true,
  "projectManager.groupList": true,
  "projectManager.ignoreProjectsWithinProjects": true,
  "projectManager.showParentFolderInfoOnDuplicates": true,
  "projectManager.tags": [
    "Private",
    "AKQA",
    "Sitecore",
    "XM Cloud",
    "Umbraco",
    "Umbraco Cloud",
    "Headless",
    "Astro",
    "SolidJS",
    "NextJS",
  ],
  "projectManager.git.baseFolders": ["__HOME__/Projects"],
  "projectManager.vscode.baseFolders": [
    "__HOME__/Projects/Workspaces",
  ],
  "projectManager.any.baseFolders": ["__HOME__/Projects"],
  "projectManager.git.ignoredFolders": [
    "node_modules",
    "out",
    "typings",
    "test",
    ".haxelib",
    ".csproj",
  ],
  "projectManager.vscode.ignoredFolders": [
    "node_modules",
    "out",
    "typings",
    "test",
    ".git",
    ".csproj",
  ],
  "projectManager.any.ignoredFolders": [
    "node_modules",
    "out",
    "typings",
    "test",
    ".csproj",
    ".git",
  ],
  "scss.lint.unknownAtRules": "ignore",
  "css.lint.unknownAtRules": "ignore",
  "explorer.confirmDelete": false,
  "workbench.iconTheme": "symbols",
  "codestream.serverUrl": "https://codestream-api-v2-us1.service.newrelic.com",
  "editor.minimap.enabled": true,
  "workbench.activityBar.orientation": "vertical",
  "workbench.editor.wrapTabs": true,
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.editor.pinnedTabsOnSeparateRow": true,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorStyle": "line-thin",
  "workbench.preferredDarkColorTheme": "One Dark Pro Monokai Darker",
  "workbench.tree.renderIndentGuides": "always",
  "workbench.editor.autoLockGroups": {
    "mainThreadWebview-browserPreview": false,
    "mainThreadWebview-simpleBrowser.view": false,
    "workbench.editor.chatSession": true,
  },
  "errorLens.statusBarColorsEnabled": true,
  "git.autofetch": true,
  "sync.gist": "78d5c8468c9fcd042dd56b2ad7108d27",
  "sonarlint.rules": {
    "typescript:S4123": {
      "level": "off",
    },
    "css:S4662": {
      "level": "off",
    },
  },
  "cursor.cmdk.useThemedDiffBackground": true,
  "cursor.composer.collapsePaneInputBoxPills": true,
  "cursor.composer.renderPillsInsteadOfBlocks": true,
  "explorer.compactFolders": false,
  "scm.compactFolders": false,
  "sync.autoDownload": false,
  "sync.autoUpload": true,
  "sync.forceUpload": true,
  "sync.quietSync": true,
  "tailwindcss-highlight.languages": [
    "html",
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "vue",
    "php",
    "blade",
    "svelte",
    "liquid",
  ],
  "explorer.confirmDragAndDrop": false,
  "cursor.composer.shouldAllowCustomModes": true,
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "githubPullRequests.pullBranch": "never",
  "git.openRepositoryInParentFolders": "never",
  "diffEditor.ignoreTrimWhitespace": false,
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.defaultFormatter": "redhat.vscode-yaml",
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "remote.SSH.remotePlatform": {
    "linuxbro": "linux",
    "superbro": "linux",
  },
  "markdown-pdf.breaks": true,
  "markdown-pdf.highlightStyle": "a11y-dark.css",
  "workbench.colorTheme": "Bearded Theme Black & Ruby",
  "window.autoDetectColorScheme": false,
  "cursor.general.emailPrivacyEnabled": true,
  "cursor.composer.showEmptyStateTips": false,
  "cursor.worktreeMaxCount": 5,
  "cursor.general.glassShowWarningNotifications": true,
  "workbench.reduceMotion": "off",
  "cursor.composer.editorConversationDensity": "compact-ungrouped",
}

      "command": "cmux-open \"$ATLASSIAN_FISKARS_JIRA_URL/issues/?jql=assignee%20%3D%20currentUser()%20AND%20resolution%20%3D%20Unresolved%20ORDER%20BY%20updated%20DESC\"",
      "icon": {
        "type": "emoji",
        "value": "\ud83d\udccb"

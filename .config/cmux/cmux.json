    "servers-workspace": {
      "command": "cmux new-workspace --name 'Servers' --focus true --layout '{\"direction\":\"horizontal\",\"split\":0.5,\"children\":[{\"pane\":{\"surfaces\":[{\"type\":\"terminal\",\"command\":\"ssh superbro\"}]}},{\"pane\":{\"surfaces\":[{\"type\":\"terminal\",\"command\":\"ssh linuxbro\"}]}}]}'",
      "icon": {
        "type": "emoji",
        "value": "\ud83d\udda5\ufe0f"
      },
      "keywords": [
        "servers",
        "workspace",
        "ssh",
        "homelab",
        "superbro",
        "linuxbro"
      ],
      "subtitle": "superbro + linuxbro side-by-side",
      "target": "currentTerminal",
      "title": "Servers \u00b7 Open Workspace",
      "type": "command"
    },

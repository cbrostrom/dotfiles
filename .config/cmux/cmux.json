    "jira-akqa-mine": {
      "command": "cmux-open \"$ATLASSIAN_AKQA_JIRA_URL/issues/?jql=assignee%20%3D%20currentUser()%20AND%20resolution%20%3D%20Unresolved%20ORDER%20BY%20updated%20DESC\"",
      "icon": {
        "type": "emoji",
        "value": "\ud83d\udccb"
      },
      "keywords": [
        "jira",
        "akqa",
        "mine",
        "assigned"
      ],
      "target": "currentTerminal",
      "title": "Jira \u00b7 AKQA \u2014 my open issues",
      "type": "command"
    },
    "jira-fiskars": {
      "command": "cmux-open \"$ATLASSIAN_FISKARS_JIRA_URL\"",
      "icon": {
        "type": "emoji",
        "value": "\ud83d\udfe0"
      },
      "keywords": [
        "jira",
        "fiskars",
        "tickets"
      ],
      "target": "currentTerminal",
      "title": "Jira \u00b7 Fiskars",

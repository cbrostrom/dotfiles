    "launch-all-projects": {
      "command": "cmux new-workspace --name 'Fiskars' --color 'Orange' && cmux new-workspace --name 'Laesr' --color 'Teal' && cmux new-workspace --name 'Huskr' --color 'Green' && cmux new-workspace --name 'Dotfiles' --color 'Charcoal' && cmux new-workspace --name 'Agents' --color 'Purple' && cmux new-workspace --name 'Servers' --color 'Crimson'",
      "icon": {
        "type": "emoji",
        "value": "\ud83d\ude80"
      },
      "keywords": [
        "launch",
        "boot",
        "start",
        "projects"
      ],
      "subtitle": "Boot core workspaces with brand colors",
      "target": "currentTerminal",
      "title": "\ud83d\ude80 Launch All Projects",
      "type": "command"
    },
    "open-dotfiles": {
      "command": "cd ~/dotfiles && exec zsh -l",
      "icon": {
        "type": "emoji",
        "value": "\u2699\ufe0f"
      },
      "keywords": [
        "dotfiles",
        "config"
      ],
      "subtitle": "~/dotfiles",
      "target": "newTabInCurrentPane",
      "title": "Open dotfiles",
      "type": "command"
    },
    "open-edit-here": {
      "command": "code .",
      "icon": {
        "type": "emoji",
        "value": "\ud83d\udcdd"
      },
      "keywords": [
        "code",
        "vscode",
        "editor"
      ],
      "target": "currentTerminal",
      "title": "Open cwd in VS Code",
      "type": "command"
    },
    "open-fiskars": {
      "command": "cd ~/Projects/Shopify/Fiskars/stellar-shopify && exec zsh -l",
      "icon": {
        "type": "emoji",
        "value": "\ud83d\udfe0"
      },
      "keywords": [
        "fiskars",
        "stellar",
        "shopify"
      ],
      "subtitle": "~/Projects/Shopify/Fiskars/stellar-shopify",

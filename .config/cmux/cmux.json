{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "actions": {
    "confluence-akqa": {
      "command": "cmux-open \"$ATLASSIAN_AKQA_CONFLUENCE_URL\"",
      "icon": {
        "type": "emoji",
        "value": "\ud83d\udcd8"
      },
      "keywords": [
        "confluence",
        "akqa",
        "wiki",
        "docs"
      ],
      "target": "currentTerminal",
      "title": "Confluence \u00b7 AKQA",
      "type": "command"
    },
    "confluence-fiskars": {
      "command": "cmux-open \"$ATLASSIAN_FISKARS_CONFLUENCE_URL\"",

  "app": {
    "appearance": "system",
    "commandPaletteSearchesAllSurfaces": true,
    "newWorkspacePlacement": "afterCurrent",
    "openMarkdownInCmuxViewer": false,
    "preferredEditor": "code",
    "reorderOnNotification": true,
    "warnBeforeClosingTab": true,
    "warnBeforeQuit": true
  },
  "automation": {
    "claudeCodeIntegration": false,
    "cursorIntegration": true,
    "geminiIntegration": true,
    "portBase": 9100,
    "portRange": 10,
    "socketControlMode": "cmuxOnly"
  },
  "browser": {
    "defaultSearchEngine": "google",
    "hostsToOpenInEmbeddedBrowser": [
      "*.myshopify.com",
      "*.shopifypreview.com",
      "*.trycloudflare.com",
      "100.100.1.50",
      "100.64.0.0/10"
    ],
    "insecureHttpHostsAllowedInEmbeddedBrowser": [
      "localhost",
      "*.localhost",
      "127.0.0.1",
      "::1",
      "0.0.0.0",
      "*.localtest.me",
      "100.100.1.50"
    ],
    "interceptTerminalOpenCommandInCmuxBrowser": true,
    "openTerminalLinksInCmuxBrowser": true,
    "showImportHintOnBlankTabs": false,
    "showSearchSuggestions": true,
    "theme": "system",
    "urlsToAlwaysOpenExternally": [
      "https://github.com/*",
      "https://*.atlassian.net/*"
    ]
  },
  "customSidebars": {
    "renderer": "inProcess"
  },
  "notifications": {
    "dockBadge": true,
    "paneFlash": true,
    "showInMenuBar": true,
    "sound": "default",
    "unreadPaneRing": true
  },
  "schemaVersion": 1,
  "shortcuts": {
    "bindings": {
      "equalizeSplits": [
        "ctrl+shift+s",
        "plus"
      ],
      "find": [
        "ctrl+shift+s",
        "f"
      ],
      "reloadConfiguration": [
        "ctrl+shift+s",
        "r"
      ],
      "saveFilePreview": null,
      "showNotifications": "ctrl+alt+shift+0",
      "splitBrowserDown": [
        "ctrl+shift+s",
        "shift+b"
      ],
      "splitBrowserRight": [
        "ctrl+shift+s",
        "b"
      ],
      "splitDown": [
        "ctrl+shift+s",
        "arrowdown"
      ],
      "splitRight": [
        "ctrl+shift+s",
        "arrowright"
      ],
      "toggleSplitZoom": [
        "ctrl+shift+s",
        "z"
      ],
      "toggleTerminalCopyMode": [
        "ctrl+shift+s",
        "c"
      ]
    }
  },
  "sidebar": {
    "branchLayout": "vertical",
    "hideAllDetails": false,
    "makePullRequestsClickable": true,
    "openPortLinksInCmuxBrowser": true,
    "openPullRequestLinksInCmuxBrowser": true,
    "showBranchDirectory": true,
    "showCustomMetadata": true,
    "showLog": true,
    "showNotificationMessage": true,
    "showPorts": true,
    "showProgress": true,
    "showPullRequests": true,
    "showSSH": true
  },
  "terminal": {
    "autoResumeAgentSessions": true,
    "showScrollBar": false
  },
  "workspaceColors": {
    "colors": {
      "Amber": "#7D6608",
      "Aqua": "#0E6B8C",
      "Blue": "#1565C0",
      "Brown": "#7B3F00",
      "Charcoal": "#3E4B5E",
      "Crimson": "#922B21",
      "Green": "#196F3D",
      "Indigo": "#283593",
      "Magenta": "#AD1457",
      "Navy": "#1A5276",
      "Olive": "#4A5C18",
      "Orange": "#A04000",
      "Purple": "#6A1B9A",
      "Red": "#C0392B",
      "Rose": "#880E4F",
      "Teal": "#006B6B"
    },
    "indicatorStyle": "leftRail"
  }
}

{
  // ─── PERFORMANCE ──────────────────────────────────────────────────────────
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.hg/store/**": true,
    "**/dist/**": true,
    "**/.next/**": true,
    "**/build/**": true,
    "**/.cache/**": true
  },
  "files.exclude": {
    "**/.DS_Store": true,
    "**/__pycache__": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/dist": true,
    "**/.next": true,
    "**/build": true,
    "**/.git": true,
    "**/.cache": true
  },
  "extensions.autoUpdate": false,
  "telemetry.telemetryLevel": "off",

  // ─── TYPESCRIPT PERFORMANCE ───────────────────────────────────────────────
  "typescript.tsserver.log": "off",
  "typescript.disableAutomaticTypeAcquisition": true,
  "typescript.tsserver.experimental.enableProjectDiagnostics": false,
  "typescript.suggest.autoImports": true,
  "javascript.suggest.autoImports": true,

  // ─── UI ───────────────────────────────────────────────────────────────────
  "editor.minimap.enabled": false,
  "breadcrumbs.enabled": false,
  "editor.codeLens": false,
  "window.menuBarVisibility": "classic",
  "editor.renderWhitespace": "boundary",
  "editor.guides.bracketPairs": false,
  "editor.guides.indentation": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.glyphMargin": false,
  "files.maxMemoryForLargeFilesMB": 4096,
  "explorer.compactFolders": false,
  "editor.scrollBeyondLastLine": false,
  "editor.overviewRulerBorder": false,

  // ─── EDITOR ───────────────────────────────────────────────────────────────
  "editor.fontSize": 13,
  "editor.fontFamily": "'Cascadia Code', 'JetBrains Mono', 'Fira Code', Consolas, monospace",
  "editor.fontLigatures": true,
  "editor.lineHeight": 1.5,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": true,
  "editor.wordWrap": "off",
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "editor.linkedEditing": true,
  "editor.suggest.preview": true,
  "editor.quickSuggestions": { "strings": "on" },

  // ─── SAVE ─────────────────────────────────────────────────────────────────
  "files.autoSave": "onFocusChange",
  "editor.formatOnSave": true,
  "editor.formatOnType": false,
  "editor.formatOnPaste": false,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "never"
  },

  // ─── SECURITY ─────────────────────────────────────────────────────────────
  "security.workspace.trust.enabled": false,

  // ─── REMOTE ───────────────────────────────────────────────────────────────
  "remote.extensionKind": {
    "vscode.git": ["workspace"],
    "vscode.git-base": ["workspace"]
  },

  // ─── GIT ──────────────────────────────────────────────────────────────────
  "git.enabled": true,
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.postCommitCommand": "none",
  "git.useCommitInputAsStashMessage": true,
  "scm.diffDecorations": "gutter",

  // ─── TERMINAL ─────────────────────────────────────────────────────────────
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.scrollback": 5000,
  "terminal.integrated.smoothScrolling": true,

  // ─── WORKBENCH ────────────────────────────────────────────────────────────
  "workbench.editor.showTabs": "multiple",
  "workbench.editor.limit.enabled": true,
  "workbench.editor.limit.value": 10,
  "workbench.editor.limit.perEditorGroup": true,
  "workbench.startupEditor": "none",
  "workbench.tree.indent": 16,
  "workbench.list.smoothScrolling": true,
  "workbench.activityBar.location": "default",
  "workbench.activityBar.compact": true,
  "workbench.secondarySideBar.showLabels": false,
  "workbench.panel.showLabels": false,
  "workbench.settings.enableNaturalLanguageSearch": true,
  "workbench.iconTheme": "ayu",
  "workbench.colorTheme": "Ayu Dark Bordered",

  // ─── WHICH-KEY LEADER (alt+space / alt+alt) ───────────────────────────────
  "whichkey.sortOrder": "alphabetically",
  "whichkey.delay": 0,
  "whichkey.bindings": [
    {
      "key": "f",
      "name": "File",
      "type": "bindings",
      "bindings": [
        { "key": "f", "name": "Find file",        "type": "command", "command": "workbench.action.quickOpen" },
        { "key": "s", "name": "Save",              "type": "command", "command": "workbench.action.files.save" },
        { "key": "S", "name": "Save all",          "type": "command", "command": "workbench.action.files.saveAll" },
        { "key": "r", "name": "Recent",            "type": "command", "command": "workbench.action.openRecent" },
        { "key": "n", "name": "New file",          "type": "command", "command": "workbench.action.files.newUntitledFile" },
        { "key": "e", "name": "Explorer",          "type": "command", "command": "workbench.view.explorer" }
      ]
    },
    {
      "key": "g",
      "name": "Git",
      "type": "bindings",
      "bindings": [
        { "key": "s", "name": "Source control",   "type": "command", "command": "workbench.view.scm" },
        { "key": "b", "name": "Branches",         "type": "command", "command": "git.checkout" },
        { "key": "c", "name": "Commit",           "type": "command", "command": "git.commit" },
        { "key": "C", "name": "Claude commit",    "type": "command", "command": "workbench.action.tasks.runTask", "args": "Claude Commit" },
        { "key": "p", "name": "Push",             "type": "command", "command": "git.push" },
        { "key": "P", "name": "Pull",             "type": "command", "command": "git.pull" },
        { "key": "d", "name": "Diff",             "type": "command", "command": "git.openChange" },
        { "key": "f", "name": "Fetch",            "type": "command", "command": "git.fetch" },
        { "key": "l", "name": "Log",              "type": "command", "command": "gitlens.showQuickRepoHistory" }
      ]
    },
    {
      "key": "t",
      "name": "Terminal",
      "type": "bindings",
      "bindings": [
        { "key": "t", "name": "Toggle",           "type": "command", "command": "workbench.action.terminal.toggleTerminal" },
        { "key": "n", "name": "New",              "type": "command", "command": "workbench.action.terminal.new" },
        { "key": "k", "name": "Kill",             "type": "command", "command": "workbench.action.terminal.kill" },
        { "key": "s", "name": "Split",            "type": "command", "command": "workbench.action.terminal.split" }
      ]
    },
    {
      "key": "e",
      "name": "Editor",
      "type": "bindings",
      "bindings": [
        { "key": "f", "name": "Format",           "type": "command", "command": "editor.action.formatDocument" },
        { "key": "r", "name": "Rename symbol",    "type": "command", "command": "editor.action.rename" },
        { "key": "d", "name": "Go to definition", "type": "command", "command": "editor.action.revealDefinition" },
        { "key": "p", "name": "Peek definition",  "type": "command", "command": "editor.action.peekDefinition" },
        { "key": "s", "name": "Split right",      "type": "command", "command": "workbench.action.splitEditor" },
        { "key": "z", "name": "Zen mode",         "type": "command", "command": "workbench.action.toggleZenMode" },
        { "key": "a", "name": "Code actions",     "type": "command", "command": "editor.action.quickFix" }
      ]
    },
    {
      "key": "b",
      "name": "Buffer/Tab",
      "type": "bindings",
      "bindings": [
        { "key": "b", "name": "Show all",         "type": "command", "command": "workbench.action.showAllEditors" },
        { "key": "d", "name": "Close tab",        "type": "command", "command": "workbench.action.closeActiveEditor" },
        { "key": "n", "name": "Next tab",         "type": "command", "command": "workbench.action.nextEditor" },
        { "key": "p", "name": "Prev tab",         "type": "command", "command": "workbench.action.previousEditor" },
        { "key": "o", "name": "Close others",     "type": "command", "command": "workbench.action.closeOtherEditors" }
      ]
    },
    {
      "key": "s",
      "name": "Search",
      "type": "bindings",
      "bindings": [
        { "key": "s", "name": "Search files",     "type": "command", "command": "workbench.action.findInFiles" },
        { "key": "r", "name": "Replace files",    "type": "command", "command": "workbench.action.replaceInFiles" },
        { "key": "S", "name": "Symbols",          "type": "command", "command": "workbench.action.gotoSymbol" },
        { "key": "c", "name": "Commands",         "type": "command", "command": "workbench.action.showCommands" }
      ]
    },
    {
      "key": "w",
      "name": "Window/Pane",
      "type": "bindings",
      "bindings": [
        { "key": "h", "name": "Focus left",       "type": "command", "command": "workbench.action.focusLeftGroup" },
        { "key": "l", "name": "Focus right",      "type": "command", "command": "workbench.action.focusRightGroup" },
        { "key": "k", "name": "Focus up",         "type": "command", "command": "workbench.action.focusAboveGroup" },
        { "key": "j", "name": "Focus down",       "type": "command", "command": "workbench.action.focusBelowGroup" },
        { "key": "d", "name": "Close pane",       "type": "command", "command": "workbench.action.closeEditorsInGroup" },
        { "key": "=", "name": "Equalise",         "type": "command", "command": "workbench.action.evenEditorWidths" }
      ]
    },
    {
      "key": "p",
      "name": "Project",
      "type": "bindings",
      "bindings": [
        { "key": "p", "name": "Open recent",      "type": "command", "command": "workbench.action.openRecent" },
        { "key": "f", "name": "Find file",        "type": "command", "command": "workbench.action.quickOpen" }
      ]
    }
  ],

  // ─── LANGUAGE SPECIFIC ────────────────────────────────────────────────────
  "[javascript]":       { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[javascriptreact]":  { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[typescript]":       { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[typescriptreact]":  { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[json]":             { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[jsonc]":            { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[css]":              { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[scss]":             { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[html]":             { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[liquid]":           { "editor.formatOnSave": false },
  "[markdown]":         { "editor.wordWrap": "on", "editor.formatOnSave": false },

  // ─── CLAUDE CODE ──────────────────────────────────────────────────────────
  "claudeCode.preferredLocation": "panel",

  // ─── THEME OVERRIDES — Ayu Dark Bordered → dark gray borders ─────────────
  "workbench.colorCustomizations": {
    "[Ayu Dark Bordered]": {
      "activityBar.border":               "#111113",
      "sideBar.border":                   "#111113",
      "panel.border":                     "#111113",
      "editorGroup.border":               "#111113",
      "tab.border":                       "#101013",
      "tab.activeBorder":                 "#101013",
      "statusBar.border":                 "#111113",
      "titleBar.border":                  "#101013",
      "input.border":                     "#141416",
      "dropdown.border":                  "#141416",
      "focusBorder":                      "#e6b45066",
      "editor.background":                "#0d0d0f",
      "sideBar.background":               "#0a0a0c",
      "activityBar.background":           "#0a0a0c",
      "titleBar.activeBackground":        "#0f0f12",
      "titleBar.inactiveBackground":      "#0d0d0f",
      "statusBar.background":             "#0a0a0c",
      "statusBar.noFolderBackground":     "#0a0a0c",
      "statusBar.debuggingBackground":    "#2a1500",
      "panel.background":                 "#0a0a0c",
      "tab.activeBackground":             "#0d0d0f",
      "tab.inactiveBackground":           "#0a0a0c",
      "tab.unfocusedActiveBackground":    "#0d0d0f",
      "editorGroupHeader.tabsBackground": "#0a0a0c",
      "editor.lineHighlightBackground":   "#101013",
      "statusBar.foreground":                    "#e6b450",
      "statusBarItem.remoteBackground":          "#e6b45022",
      "statusBarItem.remoteForeground":          "#e6b450",
      "activityBar.activeBorder":                "#e6b450",
      "activityBar.activeBackground":            "#e6b45015",
      "activityBar.foreground":                  "#c8ccd4",
      "activityBar.inactiveForeground":          "#4a4a4d",
      "badge.background":                        "#e6b45033",
      "badge.foreground":                        "#e6b450",
      "activityBarBadge.background":             "#e6b450",
      "activityBarBadge.foreground":             "#0d0d0f",
      "list.activeSelectionBackground":          "#1e1e22",
      "list.activeSelectionForeground":          "#e6b450",
      "list.inactiveSelectionBackground":        "#101013",
      "list.hoverBackground":                    "#101013",
      "list.highlightForeground":                "#e6b450",
      "list.focusHighlightForeground":           "#e6b450",
      "editor.selectionBackground":              "#e6b45025",
      "editor.selectionHighlightBackground":     "#e6b45015",
      "editorCursor.foreground":                 "#e6b450",
      "terminalCursor.foreground":               "#e6b450",
      "button.background":                       "#e6b45033",
      "button.foreground":                       "#e6b450",
      "button.hoverBackground":                  "#e6b45055",
      "textLink.foreground":                     "#e6b450",
      "textLink.activeForeground":               "#f0c060",
      "editorLink.activeForeground":             "#e6b450",
      "inputOption.activeBorder":                "#e6b45066",
      "inputOption.activeBackground":            "#e6b45015",
      "progressBar.background":                  "#e6b450",
      "scrollbarSlider.background":              "#14141655",
      "scrollbarSlider.hoverBackground":         "#3a3a3d88",
      "scrollbarSlider.activeBackground":        "#4a4a4daa"
    }
  }
}

[Unit]
Description=Game Desktop File Sync Timer
Documentation=man:systemd.timer(5)
Requires=game-desktop-sync.service

[Timer]
# Run on boot (after 2 minutes)
OnBootSec=2min

# Run every hour
OnUnitActiveSec=1h

# Run when system wakes from sleep
OnCalendar=hourly

# Persist timer across reboots
Persistent=true

[Install]
WantedBy=timers.target

#!/bin/bash
#
# Kill Game - Force kill stuck game processes
#
# Usage:
#   kill-game [app_id]
#   kill-game avatar
#   kill-game all

APP_ID="$1"

if [[ -z "$APP_ID" ]]; then
    echo "Usage: kill-game [app_id|game_name|all]"
    echo ""
    echo "Examples:"
    echo "  kill-game 2840770        # Kill Avatar by app ID"
    echo "  kill-game avatar         # Kill Avatar by name"
    echo "  kill-game all            # Kill all game processes"
    exit 1
fi

# Function to kill processes by pattern
kill_by_pattern() {
    local pattern="$1"
    local pids=$(pgrep -f "$pattern")
    
    if [[ -n "$pids" ]]; then
        echo "Killing processes matching: $pattern"
        echo "$pids" | while read pid; do
            echo "  Killing PID $pid: $(ps -p $pid -o comm=)"
            kill -9 "$pid" 2>/dev/null
        done
        echo "Done!"
    else
        echo "No processes found matching: $pattern"
    fi
}

case "$APP_ID" in
    all)
        echo "Killing all game/Proton processes..."
        kill_by_pattern "\.exe$"
        kill_by_pattern "proton"
        kill_by_pattern "wineserver"
        kill_by_pattern "wine"
        ;;
    avatar|2840770)
        echo "Killing Avatar: Frontiers of Pandora..."
        kill_by_pattern "afop.exe"
        kill_by_pattern "2840770"
        ;;
    *)
        echo "Killing processes for app ID: $APP_ID"
        kill_by_pattern "$APP_ID"
        ;;
esac

# Also kill any orphaned wineserver processes
pkill -9 wineserver 2>/dev/null && echo "Killed orphaned wineserver processes"

echo ""
echo "Cleanup complete!"

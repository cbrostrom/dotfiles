#!/bin/bash
# Diablo 4 - Disable Shader Pre-Compilation Completely

echo "=== Diablo 4 - Disable Steam Shader Pre-Compilation ==="
echo ""

SHADER_CACHE_DIR="$HOME/.local/share/Steam/steamapps/shadercache/2344520"
SHADER_SETTINGS="$HOME/.steam/steam/config/config.vdf"

echo "This will:"
echo "1. Kill any running shader compilation processes"
echo "2. Remove shader pre-cache for Diablo 4"
echo "3. Create a dummy file to prevent re-creation"
echo ""
read -p "Continue? [y/N]: " confirm

if [[ "$confirm" != "y" ]]; then
    echo "Cancelled."
    exit 0
fi

# Kill fossilize processes
echo ""
echo "Killing shader compilation processes..."
pkill -9 fossilize 2>/dev/null && echo "✓ Killed fossilize" || echo "✓ No fossilize running"

# Remove Vulkan shader cache
echo ""
echo "Removing Vulkan shader cache..."
if [[ -d "$SHADER_CACHE_DIR/fozpipelinesv6" ]]; then
    rm -rf "$SHADER_CACHE_DIR/fozpipelinesv6"
    echo "✓ Removed fozpipelinesv6"
fi

# Create dummy directory to prevent recreation
echo ""
echo "Creating protection..."
mkdir -p "$SHADER_CACHE_DIR"
touch "$SHADER_CACHE_DIR/.shader_cache_disabled"

# Try to make it read-only to prevent Steam from recreating
chmod 444 "$SHADER_CACHE_DIR/.shader_cache_disabled" 2>/dev/null

echo ""
echo "✓ Done!"
echo ""
echo "=== Next Steps ==="
echo ""
echo "1. In Steam Settings:"
echo "   Settings → Shader Pre-Caching → Disable it"
echo ""
echo "2. Launch Diablo 4 with:"
echo "   gamelaunch --preset diablo4 %command%"
echo ""
echo "3. Skip shader compilation if Steam asks"
echo ""
echo "Note: You MUST disable shader pre-caching in Steam settings"
echo "      for this to work permanently!"

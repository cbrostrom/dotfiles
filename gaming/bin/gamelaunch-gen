#!/bin/bash
#
# Game Launch Generator
# Generates Steam launch options from presets
#
# Usage:
#   gamelaunch-gen nvidia-1080p
#   gamelaunch-gen --list

PRESETS_FILE="$HOME/.config/game-launcher/presets.conf"

if [[ ! -f "$PRESETS_FILE" ]]; then
    echo "Error: Presets file not found: $PRESETS_FILE"
    exit 1
fi

# Show help
if [[ "$1" == "--help" || "$1" == "-h" ]]; then
    cat << 'EOF'
Game Launch Generator - Generate Steam launch options from presets

Usage:
  gamelaunch-gen <preset>     Generate launch options for preset
  gamelaunch-gen --list       List all available presets
  gamelaunch-gen --help       Show this help

Examples:
  gamelaunch-gen nvidia-1080p
  gamelaunch-gen competitive
  gamelaunch-gen diablo4

The output can be copy-pasted directly into Steam launch options.
EOF
    exit 0
fi

# List presets
if [[ "$1" == "--list" || "$1" == "-l" ]]; then
    echo "Available presets:"
    grep -E '^\[.+\]$' "$PRESETS_FILE" | sed 's/\[//g' | sed 's/\]//g' | sed 's/^/  - /'
    exit 0
fi

PRESET="$1"

if [[ -z "$PRESET" ]]; then
    echo "Error: No preset specified"
    echo "Usage: gamelaunch-gen <preset>"
    echo "Run 'gamelaunch-gen --list' to see available presets"
    exit 1
fi

# Parse preset
PRESET_FOUND=false
USE_GAMEMODE=false
USE_MANGOHUD=false
MANGOHUD_CONFIG=""
CUSTOM_ENV=""

while IFS= read -r line; do
    # Skip comments and empty lines
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    [[ -z "$line" ]] && continue
    
    # Check for preset section
    if [[ "$line" =~ ^\[(.+)\]$ ]]; then
        CURRENT_SECTION="${BASH_REMATCH[1]}"
        if [[ "$CURRENT_SECTION" == "$PRESET" ]]; then
            PRESET_FOUND=true
        else
            if [[ "$PRESET_FOUND" == true ]]; then
                break
            fi
        fi
    elif [[ "$PRESET_FOUND" == true ]]; then
        # Parse preset settings
        if [[ "$line" =~ ^gamemode=(.+)$ ]]; then
            [[ "${BASH_REMATCH[1]}" == "true" ]] && USE_GAMEMODE=true
        elif [[ "$line" =~ ^mangohud=(.+)$ ]]; then
            [[ "${BASH_REMATCH[1]}" == "true" ]] && USE_MANGOHUD=true
        elif [[ "$line" =~ ^mangohud_config=(.+)$ ]]; then
            MANGOHUD_CONFIG="${BASH_REMATCH[1]}"
        elif [[ "$line" =~ ^env=(.+)$ ]]; then
            CUSTOM_ENV="${BASH_REMATCH[1]}"
        fi
    fi
done < "$PRESETS_FILE"

if [[ "$PRESET_FOUND" == false ]]; then
    echo "Error: Preset '$PRESET' not found"
    echo "Run 'gamelaunch-gen --list' to see available presets"
    exit 1
fi

# Build launch options
LAUNCH_OPTIONS=""

# Add environment variables
if [[ -n "$CUSTOM_ENV" ]]; then
    LAUNCH_OPTIONS="$CUSTOM_ENV "
fi

# Add MangoHud config
if [[ "$USE_MANGOHUD" == true && -n "$MANGOHUD_CONFIG" ]]; then
    LAUNCH_OPTIONS="${LAUNCH_OPTIONS}MANGOHUD_CONFIG=$MANGOHUD_CONFIG "
fi

# Add gamemode
if [[ "$USE_GAMEMODE" == true ]]; then
    LAUNCH_OPTIONS="${LAUNCH_OPTIONS}gamemoderun "
fi

# Add mangohud
if [[ "$USE_MANGOHUD" == true ]]; then
    LAUNCH_OPTIONS="${LAUNCH_OPTIONS}mangohud "
fi

# Add %command%
LAUNCH_OPTIONS="${LAUNCH_OPTIONS}%command%"

# Output
echo ""
echo "Steam Launch Options for preset: $PRESET"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "$LAUNCH_OPTIONS"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""
echo "Copy the line above and paste it into:"
echo "Steam → Right-click game → Properties → Launch Options"
echo ""

#!/bin/bash
#
# Game Launch Wrapper
# Simple launcher script for Steam games with gamemode + mangohud support
#
# Usage in Steam Launch Options:
#   gamelaunch %command%
#   gamelaunch --preset diablo4 %command%
#   gamelaunch --gamemode --mangohud %command%
#

# Debug: Log that script was called
SCRIPT_DIR="$HOME/.config/game-launcher"
mkdir -p "$SCRIPT_DIR"
echo "[$(date '+%Y-%m-%d %H:%M:%S')] === SCRIPT CALLED ===" >> "$SCRIPT_DIR/launch.log"
echo "[$(date '+%Y-%m-%d %H:%M:%S')] Script path: $0" >> "$SCRIPT_DIR/launch.log"
echo "[$(date '+%Y-%m-%d %H:%M:%S')] Args count: $#" >> "$SCRIPT_DIR/launch.log"
echo "[$(date '+%Y-%m-%d %H:%M:%S')] All args: $@" >> "$SCRIPT_DIR/launch.log"

PRESETS_FILE="$SCRIPT_DIR/presets.conf"

# Default settings
USE_GAMEMODE=false
USE_MANGOHUD=false
MANGOHUD_CONFIG=""
CUSTOM_ENV=""
PRESET=""

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        --preset)
            PRESET="$2"
            shift 2
            ;;
        --gamemode)
            USE_GAMEMODE=true
            shift
            ;;
        --mangohud)
            USE_MANGOHUD=true
            shift
            ;;
        --mangohud-config)
            MANGOHUD_CONFIG="$2"
            shift 2
            ;;
        --env)
            CUSTOM_ENV="$2"
            shift 2
            ;;
        --help)
            cat << EOF
Game Launch Wrapper - Simple launcher for Steam games

Usage:
  gamelaunch [OPTIONS] %command%

Options:
  --preset NAME           Load preset configuration
  --gamemode              Enable gamemode
  --mangohud              Enable MangoHud
  --mangohud-config OPTS  Custom MangoHud config options
  --env "VAR=value"       Set custom environment variables
  --help                  Show this help message

Examples:
  # Basic usage with gamemode + mangohud
  gamelaunch --gamemode --mangohud %command%

  # Use preset
  gamelaunch --preset diablo4 %command%

  # Custom MangoHud config
  gamelaunch --gamemode --mangohud --mangohud-config "fps_limit=60" %command%

  # Custom environment variable
  gamelaunch --env "DXVK_HUD=fps" %command%

Presets are stored in: $PRESETS_FILE
EOF
            exit 0
            ;;
        *)
            # Remaining arguments are the game command
            break
            ;;
    esac
done

# Load preset if specified
if [[ -n "$PRESET" && -f "$PRESETS_FILE" ]]; then
    # Source the preset
    PRESET_FOUND=false
    PRESET_EVER_FOUND=false
    while IFS= read -r line; do
        # Skip comments and empty lines
        [[ "$line" =~ ^[[:space:]]*# ]] && continue
        [[ -z "$line" ]] && continue
        
        # Check for preset section
        if [[ "$line" =~ ^\[(.+)\]$ ]]; then
            CURRENT_SECTION="${BASH_REMATCH[1]}"
            if [[ "$CURRENT_SECTION" == "$PRESET" ]]; then
                PRESET_FOUND=true
                PRESET_EVER_FOUND=true
            else
                PRESET_FOUND=false
            fi
        elif [[ "$PRESET_FOUND" == true ]]; then
            # Parse preset settings
            if [[ "$line" =~ ^gamemode=(.+)$ ]]; then
                [[ "${BASH_REMATCH[1]}" == "true" ]] && USE_GAMEMODE=true
            elif [[ "$line" =~ ^mangohud=(.+)$ ]]; then
                [[ "${BASH_REMATCH[1]}" == "true" ]] && USE_MANGOHUD=true
            elif [[ "$line" =~ ^mangohud_config=(.+)$ ]]; then
                MANGOHUD_CONFIG="${BASH_REMATCH[1]}"
            elif [[ "$line" =~ ^env=(.+)$ ]]; then
                CUSTOM_ENV="${BASH_REMATCH[1]}"
            fi
        fi
    done < "$PRESETS_FILE"
    
    if [[ "$PRESET_EVER_FOUND" == false ]]; then
        echo "Warning: Preset '$PRESET' not found in $PRESETS_FILE"
    fi
fi

# Build launch command
LAUNCH_CMD=""
ENV_VARS=""

# Collect environment variables
if [[ -n "$CUSTOM_ENV" ]]; then
    ENV_VARS="$CUSTOM_ENV"
fi

# Add MangoHud config if needed
if [[ "$USE_MANGOHUD" == true && -n "$MANGOHUD_CONFIG" ]]; then
    if [[ -n "$ENV_VARS" ]]; then
        ENV_VARS="$ENV_VARS MANGOHUD_CONFIG='$MANGOHUD_CONFIG'"
    else
        ENV_VARS="MANGOHUD_CONFIG='$MANGOHUD_CONFIG'"
    fi
fi

# Add all environment variables at once
if [[ -n "$ENV_VARS" ]]; then
    LAUNCH_CMD="env $ENV_VARS "
fi

# Add gamemode wrapper
if [[ "$USE_GAMEMODE" == true ]]; then
    if command -v gamemoderun >/dev/null 2>&1; then
        LAUNCH_CMD="${LAUNCH_CMD}/usr/bin/gamemoderun "
    else
        echo "Warning: gamemoderun not found, skipping gamemode" >&2
    fi
fi

# Add mangohud wrapper
if [[ "$USE_MANGOHUD" == true ]]; then
    if command -v mangohud >/dev/null 2>&1; then
        LAUNCH_CMD="${LAUNCH_CMD}/usr/bin/mangohud "
    else
        echo "Warning: mangohud not found, skipping mangohud" >&2
    fi
fi

# Add the actual game command
LAUNCH_CMD="${LAUNCH_CMD}$*"

# Debug logging
echo "[$(date '+%Y-%m-%d %H:%M:%S')] === DEBUG ===" >> "$SCRIPT_DIR/launch.log"
echo "[$(date '+%Y-%m-%d %H:%M:%S')] Args count: $#" >> "$SCRIPT_DIR/launch.log"
echo "[$(date '+%Y-%m-%d %H:%M:%S')] All args: $*" >> "$SCRIPT_DIR/launch.log"
echo "[$(date '+%Y-%m-%d %H:%M:%S')] Preset: $PRESET" >> "$SCRIPT_DIR/launch.log"
echo "[$(date '+%Y-%m-%d %H:%M:%S')] ENV_VARS: $ENV_VARS" >> "$SCRIPT_DIR/launch.log"
echo "[$(date '+%Y-%m-%d %H:%M:%S')] USE_GAMEMODE: $USE_GAMEMODE" >> "$SCRIPT_DIR/launch.log"
echo "[$(date '+%Y-%m-%d %H:%M:%S')] USE_MANGOHUD: $USE_MANGOHUD" >> "$SCRIPT_DIR/launch.log"

# Export environment variables individually
if [[ -n "$CUSTOM_ENV" ]]; then
    # Parse space-separated KEY=VALUE pairs
    eval "export $CUSTOM_ENV"
fi

# Export MangoHud config if needed
if [[ "$USE_MANGOHUD" == true && -n "$MANGOHUD_CONFIG" ]]; then
    export MANGOHUD_CONFIG="$MANGOHUD_CONFIG"
fi

# Build execution chain
if [[ "$USE_GAMEMODE" == true ]] && command -v gamemoderun >/dev/null 2>&1; then
    if [[ "$USE_MANGOHUD" == true ]] && command -v mangohud >/dev/null 2>&1; then
        # Both gamemode and mangohud
        exec /usr/bin/gamemoderun /usr/bin/mangohud "$@"
    else
        # Only gamemode
        exec /usr/bin/gamemoderun "$@"
    fi
elif [[ "$USE_MANGOHUD" == true ]] && command -v mangohud >/dev/null 2>&1; then
    # Only mangohud
    exec /usr/bin/mangohud "$@"
else
    # No wrappers
    exec "$@"
fi

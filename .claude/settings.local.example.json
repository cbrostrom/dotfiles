{
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "HOME_PLACEHOLDER/.claude/hooks/entroly-start.sh",
                        "async": true
                    },
                    {
                        "type": "command",
                        "command": "HOME_PLACEHOLDER/.claude/hooks/claude-session-check.sh"
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "HOME_PLACEHOLDER/.claude/hooks/rtk-rewrite.sh"
                    }
                ]
            }
        ]
    },
    "permissions": {
        "allow": [],
        "defaultMode": "default"
    }
}

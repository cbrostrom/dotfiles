{
    "$schema": "https://code.claude.com/schemas/settings.json",
    "statusLine": {
        "type": "command",
        "command": "bash HOME_PLACEHOLDER/.claude/hooks/statusline.sh"
    },
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "HOME_PLACEHOLDER/.claude/hooks/claude-settings-merge.sh",
                        "async": true
                    }
                ]
            },
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash HOME_PLACEHOLDER/dotfiles/scripts/claude/device-snapshot.sh write",
                        "async": true
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "HOME_PLACEHOLDER/.claude/hooks/git-push-guard.sh"
                    },
                    {
                        "type": "command",
                        "command": "rtk hook claude"
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "HOME_PLACEHOLDER/.claude/hooks/effort-classifier.sh",
                        "timeout": 5
                    }
                ]
            }
        ]
    },
    "permissions": {
        "allow": [],
        "defaultMode": "default"
    }
}


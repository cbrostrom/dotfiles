{
  "permissions": {
    "additionalDirectories": [
      "$HOME/Projects/Private/vscodium-settings",
      "$HOME/dotfiles/.claude",
      "$HOME/Projects/Shopify/Fiskars/stellar-shopify/.claude/skills/style-review",
      "$HOME/Projects/Shopify/Fiskars/stellar-shopify/.claude/skills"
    ]
  },
  "hooks": {
    "PreCompact": [
      { "hooks": [{ "type": "command", "command": "$HOME/.claude/hooks/brain-save-inject.sh", "timeout": 10 }] }
    ],
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "$HOME/.claude/hooks/brain-load.sh", "timeout": 10 }] },
      { "hooks": [{ "type": "command", "command": "$HOME/.claude/hooks/entroly-start.sh", "async": true, "timeout": 10 }] },
      { "hooks": [{ "type": "command", "command": "$HOME/.claude/hooks/claude-settings-merge.sh", "async": true, "timeout": 15 }] }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "$HOME/.claude/hooks/git-push-guard.sh", "timeout": 5 },
          { "type": "command", "command": "$HOME/.claude/hooks/rtk-rewrite.sh", "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "$HOME/.claude/hooks/engram-on-stop.sh", "async": true, "timeout": 15 }] }
    ],
    "Notification": [],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "$HOME/.claude/hooks/effort-classifier.sh", "timeout": 5 }] },
      { "hooks": [{ "type": "command", "command": "$HOME/.claude/hooks/engram-on-prompt.sh", "timeout": 5 }] },
      { "hooks": [{ "type": "command", "command": "HOOK_EVENT_NAME=UserPromptSubmit $HOME/.claude/hooks/brain-save-inject.sh", "timeout": 5 }] }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/hooks/statusline.sh\""
  },
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "$GITHUB_PERSONAL_ACCESS_TOKEN" }
    },
    "apple-mcp": { "command": "bunx", "args": ["-y", "@dhravya/apple-mcp@latest"] },
    "atlassian-fiskars": {
      "command": "mcp-atlassian",
      "args": [],
      "env": {
        "JIRA_URL": "$ATLASSIAN_FISKARS_JIRA_URL",
        "JIRA_USERNAME": "$ATLASSIAN_USERNAME",
        "JIRA_API_TOKEN": "$ATLASSIAN_API_TOKEN",
        "CONFLUENCE_URL": "$ATLASSIAN_FISKARS_CONFLUENCE_URL",
        "CONFLUENCE_USERNAME": "$ATLASSIAN_USERNAME",
        "CONFLUENCE_API_TOKEN": "$ATLASSIAN_API_TOKEN"
      }
    },
    "atlassian-akqa": {
      "command": "mcp-atlassian",
      "args": [],
      "env": {
        "JIRA_URL": "$ATLASSIAN_AKQA_JIRA_URL",
        "JIRA_USERNAME": "$ATLASSIAN_USERNAME",
        "JIRA_API_TOKEN": "$ATLASSIAN_API_TOKEN",
        "CONFLUENCE_URL": "$ATLASSIAN_AKQA_CONFLUENCE_URL",
        "CONFLUENCE_USERNAME": "$ATLASSIAN_USERNAME",
        "CONFLUENCE_API_TOKEN": "$ATLASSIAN_API_TOKEN"
      }
    },
    "engram": {
      "command": "engram",
      "args": ["mcp"],
      "env": { "ENGRAM_DATA_DIR": "$HOME/.engram/personal" }
    }
  }
}

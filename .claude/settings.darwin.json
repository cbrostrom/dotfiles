{
  "enabledPlugins": {
    "atlassian@claude-plugins-official": true,
    "liquid-skills@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "permissions": {
    "additionalDirectories": [
      "$HOME/Projects/Private/vscodium-settings",
      "$HOME/dotfiles/.claude",
      "$HOME/Projects/Shopify/Fiskars/stellar-shopify/.claude/skills/style-review",
      "$HOME/Projects/Shopify/Fiskars/stellar-shopify/.claude/skills"
    ]
  },
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/brain-save-inject.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/brain-load.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/git-push-guard.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "rtk hook claude",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [],
    "Notification": [],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/effort-classifier.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/fast-mode-guard.sh",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_EVENT_NAME=UserPromptSubmit $HOME/.claude/hooks/brain-save-inject.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/hooks/statusline.sh\"",
    "refreshInterval": 5
  },
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "$GITHUB_PERSONAL_ACCESS_TOKEN"
      }
    },
    "apple-mcp": {
      "command": "bunx",
      "args": ["-y", "@dhravya/apple-mcp@latest"]
    }
  }
}

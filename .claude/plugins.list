# Claude Code plugins — CORE (loaded on every machine)
# Format: plugin@marketplace = repo_or_source
# - marketplace added (idempotent) before install
# - lines starting with # are comments, blank lines ignored
#
# Workflow overlays (opt-in per machine via DOTFILES_WORKFLOWS in ~/.zshrc.local):
#   DOTFILES_WORKFLOWS=developer   → loads plugins.developer.list
#   DOTFILES_WORKFLOWS=work        → loads plugins.work.list

# Core plugins only — agnostic stack (2026-06-16 prune).
# Removed from base: superpowers (dupes dotfiles skills), caveman, planning-with-files, cavekit.
# Work/developer overlays: plugins.work.list, plugins.developer.list

claude-md-management@claude-plugins-official = anthropics/claude-plugins-official

# Claude Code MCP servers — CORE (loaded on every machine)
# Format: name | command | arg1 | arg2 | ...
# Pipes separate tokens. Lines starting with # are comments. Blank lines ignored.
# Secrets: scripts read env from ~/.local-secrets (sourced by .zshrc).
#
# Workflow overlays (opt-in per machine via DOTFILES_WORKFLOWS in ~/.zshrc.local):
#   DOTFILES_WORKFLOWS=developer   → loads mcp-servers.developer.list
#   DOTFILES_WORKFLOWS=work        → loads mcp-servers.work.list
#   DOTFILES_WORKFLOWS=developer,work → both

# GitHub — requires GITHUB_PERSONAL_ACCESS_TOKEN in ~/.local-secrets
github | npx | -y | @modelcontextprotocol/server-github

# Memory MCPs (engram, graphiti) moved to mcp-servers.memory.list — opt-in via DOTFILES_WORKFLOWS=...,memory

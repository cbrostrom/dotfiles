# Claude Code MCP servers — registered via `claude mcp add` on bootstrap
# Format: name | command | arg1 | arg2 | ...
# Pipes separate tokens. Spaces within a token are fine.
# Lines starting with # are comments. Blank lines ignored.
# Secrets: scripts read env from ~/.local-secrets (sourced by .zshrc).
# Tailscale-only servers (graphiti, dockhand) will fail silently
# at first use on machines not enrolled in the tailnet.

# --- Local ---

# GitHub — requires GITHUB_PERSONAL_ACCESS_TOKEN in ~/.local-secrets
github | npx | -y | @modelcontextprotocol/server-github

# lean-ctx — token-saving context tool. Binary installed via cargo or brew.
lean-ctx | lean-ctx

# Mermaid diagram generator
mcp-mermaid | npx | -y | mcp-mermaid

# Shopify dev tools — provided by shopify-plugin (shopify-mcp). Manual entry removed to avoid duplicate.

# Tailwind CSS — utilities, color palette, component templates
tailwindcss | npx | -y | tailwindcss-mcp-server

# Google Calendar — optional; first run opens browser for OAuth.
# Token cached at ~/.config/google-calendar-mcp/tokens.json.
# Skip if no Google account configured — bootstrap treats failure as non-fatal.
google-calendar | ~/.claude/scripts/google-calendar.sh

# Atlassian MCP — Fiskars workspace (script reads ATLASSIAN_FISKARS_* from .local-secrets)
atlassian-fiskars | ~/.claude/scripts/atlassian-fiskars.sh

# Atlassian MCP — AKQA workspace (script reads ATLASSIAN_AKQA_* from .local-secrets)
atlassian-akqa | ~/.claude/scripts/atlassian-akqa.sh

# --- Local (no Tailscale needed) ---

# Engram — local binary, vault at ~/.engram/personal, git-synced across machines.
# Sync: SessionStart hook pulls + imports; Stop hook exports + pushes.
# Vault repo must be initialised: git init ~/.engram && git remote add origin <repo>.
engram-personal | engram | mcp

# --- Tailscale-only (require tailnet enrollment) ---

# Graphiti — temporal knowledge graph (Neo4j) on superbro:8000
graphiti | http | http://100.100.1.50:8000/mcp

# Dockhand — superbro stack management
mcp-dockhand | http | http://100.100.1.50:8080/mcp

# Dockhand — linuxbro: add when installed on linuxbro
# mcp-dockhand-linuxbro | http | http://100.100.1.100:8080/mcp

# Claude Code MCP servers — registered via `claude mcp add` on bootstrap
# Format: name | command | arg1 | arg2 | ...
# Pipes separate tokens. Spaces within a token are fine.
# Lines starting with # are comments. Blank lines ignored.
# Profile tags (optional, comma-separated): profile:desktop-full,wsl
# Servers without profile tag install on all profiles.

# GitHub — requires GITHUB_PERSONAL_ACCESS_TOKEN in ~/.local-secrets
github | npx | -y | @modelcontextprotocol/server-github

# lean-ctx — token-saving context tool. Requires `cargo install lean-ctx`.
lean-ctx | ~/.cargo/bin/lean-ctx

# Engram personal vault — all projects (personal + work)
# Requires: SuperBro reachable via Tailscale SSH
engram-personal | ssh | superbro | ENGRAM_DATA_DIR=/home/christian/.engram/personal /home/christian/.local/bin/engram mcp

# Engram work vault — stellar-shopify only, safe to share with colleagues
# Requires: SuperBro reachable via Tailscale SSH
engram-work | ssh | superbro | ENGRAM_DATA_DIR=/home/christian/.engram/work /home/christian/.local/bin/engram mcp

# Mermaid diagram generator
mcp-mermaid | npx | -y | mcp-mermaid

# Shopify dev tools — docs, GraphQL, theme validation
shopify-dev | npx | -y | @shopify/dev-mcp@latest

# Tailwind CSS — utilities, color palette, component templates
tailwindcss | npx | -y | tailwindcss-mcp-server

# Atlassian MCP — Fiskars workspace
# Requires: ATLASSIAN_* env vars in ~/.local-secrets, mcp-atlassian installed via pipx
atlassian-fiskars | ~/.claude/scripts/atlassian-fiskars.sh

# Docker — remote daemon management via SSH (superbro + linuxbro)
# Requires: mcp-server-docker (npx), hosts reachable via Tailscale SSH
docker-superbro | ~/.claude/scripts/docker-superbro.sh
docker-linuxbro | ~/.claude/scripts/docker-linuxbro.sh

# Atlassian MCP — AKQA workspace
# Requires: ATLASSIAN_* env vars in ~/.local-secrets, mcp-atlassian installed via pipx
atlassian-akqa | ~/.claude/scripts/atlassian-akqa.sh

# Claude Code MCP servers — WORK workflow
# Loaded when DOTFILES_WORKFLOWS includes "work" (set in ~/.zshrc.local).
#
# NOTE: Atlassian MCPs (~140 tools) are NOT here — they live at project level.
# Add to .claude/settings.json in each project dir:
#
#   {
#     "mcpServers": {
#       "atlassian-akqa": {
#         "type": "stdio",
#         "command": "/home/christian/.claude/scripts/atlassian-akqa.sh"
#       }
#     }
#   }
#
# This ensures 140 tools only load when you're inside that project.
# Fiskars projects: ~/Projects/Clients/Fiskars/**  → atlassian-fiskars
# AKQA projects:    ~/Work/AKQA/**                  → atlassian-akqa

# Shopify Dev MCP — theme/app development tools
shopify-dev-mcp | npx | -y | @shopify/dev-mcp@latest

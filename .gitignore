# Secrets and sensitive files
.config/gh/
.ssh/
*.key
*.pem
*.p12
*.pfx
.local-secrets
.gitconfig.local

# Backup files
*.backup.*
*.backup_*
*.bak
*.bak.*
*.old
*~
.config/cursor/extensions.json.backup*

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Temporary files
*.tmp
*.temp

# Tool caches
.fallow/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Node modules (if any)
node_modules/

# Environment files
.env
.env.local
.env.*.local
.local-aliases
.local-config

# Gaming logs
gaming/config/launch.log

# Cursor state database (huge files)
*.vscdb
.backups/

# Zellij compiled plugin binaries (downloaded at runtime)
.config/zellij/plugins/*.wasm

# Zed machine-specific settings (merged into settings.json per machine)
.config/zed/settings.local.json
# Zed sync state (machine-local timestamp)
.zed-sync-ts

# Claude machine-specific settings (merged into settings.json per machine)
.claude/settings.local.json
# Claude auto-approved permissions (machine-local, generated at runtime)
.claude/settings.json
# Claude device snapshots — tracked in git (no secrets, used for cross-host config)
# .claude/devices/

# Codex (not used)
.codex/

# VSCodium machine-specific settings (merged into settings.json per machine)
.config/vscodium/settings.local.json
.superpowers/
.remember/
*.zwc

# Claude settings (3-layer merge)
.claude/settings.override.json
.claude/.settings-attestation
.attic/

# Herdr runtime state (generated, machine-local)
.config/herdr/session.json
.config/herdr/session-history.json
.config/herdr/release-notes.json

# PI runtime state (generated, machine-local — auth/cache/sessions/npm tree stay local)
.config/pi/agent/auth.json
.config/pi/agent/cursor-sdk-model-list.json
.config/pi/agent/cursor-sdk.json
.config/pi/agent/trust.json
.config/pi/agent/sessions/
.config/pi/agent/npm/
.config/pi/agent/pi-stats/

# Externally-installed Claude skills (managed outside dotfiles)
.claude/skills/paseo/
.claude/skills/paseo-*/
.claude/skills/use-spark/
.claude/hooks/herdr-agent-state.sh
*.original.md

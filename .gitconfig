[user]
	name = Christian Kjærulff Brostrøm
	email = 2435832+cbrostrom@users.noreply.github.com

[core]
	autocrlf = input
	excludesfile = ~/.gitignore_global

[init]
	defaultBranch = main

[alias]
	dotfiles = !git --git-dir=$HOME/.config/dotfiles/ --work-tree=$HOME

[merge]
	conflictstyle = diff3

[diff]
	colorMoved = default

[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers

# Per-machine overrides (signing keys, work email, etc.)
# Created from .gitconfig.local.example by install script.
[include]
	path = ~/.gitconfig.local
[safe]
	directory = /mnt/c/Users/christian/.engram
	directory = /home/christian/engram-sync
[merge "engram-manifest"]
	name = Engram manifest union merge
	driver = /home/christian/engram-sync/scripts/merge-manifest.py %O %A %B

#!/usr/bin/env bash
# PI shim — one canonical install under the node-agnostic npm prefix (~/.npm-global),
# so terminal pi, Paseo agents, and `pi update self` all touch the same copy.
# Update pi: piup / piups (aliases) or ~/dotfiles/scripts/pi-doctor.sh --fix

prefix="${NPM_CONFIG_PREFIX:-$HOME/.npm-global}"
fnm_root="${FNM_DIR:-$HOME/Library/Application Support/fnm}"
[[ -d "$fnm_root/node-versions" ]] || fnm_root="${XDG_DATA_HOME:-$HOME/.local/share}/fnm"

# pi is a node script; put the fnm default node first for bare shells
# (Paseo RPC, cron, ssh one-shots) where fnm never ran.
default_node="$(readlink "$fnm_root/aliases/default" 2>/dev/null || true)"
[[ -d "$default_node/bin" ]] && export PATH="$default_node/bin:$PATH"

if [[ -x "$prefix/bin/pi" ]]; then
    exec "$prefix/bin/pi" "$@"
fi

# Legacy hosts that still have pi inside an fnm node version (newest wins).
resolved=""
for d in "$fnm_root"/node-versions/v*/installation; do
    [[ -x "$d/bin/pi" ]] && resolved="$d"
done
if [[ -n "$resolved" ]]; then
    export PATH="$resolved/bin:$PATH"
    exec "$resolved/bin/pi" "$@"
fi

echo "pi: not found — run: ~/dotfiles/scripts/pi-doctor.sh --fix" >&2
exit 127

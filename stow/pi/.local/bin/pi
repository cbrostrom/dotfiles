#!/usr/bin/env bash
# PI shim — runtime from PI_BACKEND (default auto: Pi-Bolt → managed → npm).
# Terminal pi, Paseo, and Zed pi-acp should use this entrypoint (~/.local/bin/pi).
# pi-managed · pi-pig · pi-npm · pi-bolt are explicit backends.
# Updates: piup (bolt + managed self + extensions) · pi-doctor.sh

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles}"
# shellcheck source=/dev/null
. "$DOTFILES_DIR/scripts/pi-lib.sh"

case "$(pi_backend)" in
    bolt)
        exec "$(pi_bolt_launcher)" "$@"
        ;;
    pig)
        pi_pig_env
        exec "$(pi_pig_bin)" "$@"
        ;;
    managed)
        exec "$(pi_managed_bin)" "$@"
        ;;
    npm)
        pi_npm_exec "$@"
        ;;
esac

#!/usr/bin/env bash
# PI shim — always resolves pi from the NEWEST fnm node version that has it installed.
# Never pins to fnm default: a stale default must not shadow a newer install.
# Update pi: fnm use <newest> && npm i -g @earendil-works/pi-coding-agent
#   (or run `pi-update`)

_fnm_root="${FNM_DIR:-$HOME/Library/Application Support/fnm}"
[[ -d "$_fnm_root/node-versions" ]] || _fnm_root="${XDG_DATA_HOME:-$HOME/.local/share}/fnm"

_resolved=""
for _d in "$_fnm_root"/node-versions/v*/installation; do
    [[ -x "$_d/bin/pi" ]] && _resolved="$_d"   # glob is version-sorted ascending
done

if [[ -z "$_resolved" ]]; then
    echo "pi: not found — install with: npm install -g @earendil-works/pi-coding-agent" >&2
    exit 1
fi

# pi is a node script; make sure its own node is first on PATH for bare shells
# (Paseo RPC, cron, ssh one-shots) where fnm never ran.
export PATH="$_resolved/bin:$_resolved/installation/bin:$PATH"
exec "$_resolved/bin/pi" "$@"

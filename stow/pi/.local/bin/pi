#!/usr/bin/env bash
# PI shim — Pi-Bolt when installed, else npm @earendil-works/pi-coding-agent.
# Terminal pi, Paseo (pi-paseo), and package installs should share this entrypoint.
# Force npm: PI_BACKEND=npm pi …  or use pi-npm.
# Updates: pi-bolt update (Bolt) · pi-npm update --all (npm fallback) · pi-doctor.sh

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles}"
# shellcheck source=/dev/null
. "$DOTFILES_DIR/scripts/pi-lib.sh"

case "$(pi_backend)" in
    bolt)
        exec "$(pi_bolt_launcher)" "$@"
        ;;
    npm)
        pi_npm_exec "$@"
        ;;
esac

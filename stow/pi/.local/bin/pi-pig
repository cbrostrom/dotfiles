#!/usr/bin/env bash
# PiG (Go pi) using shared ~/.pi/agent config (PIG_USE_PI_DIRS=1).
# Some TS extensions (cursor-sdk, yaml-hooks) are not PiG-parity yet — prefer pi / Pi-Bolt.
DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles}"
# shellcheck source=/dev/null
. "$DOTFILES_DIR/scripts/pi-lib.sh"
if bin="$(pi_pig_bin)"; then
    pi_pig_env
    exec "$bin" "$@"
fi
printf 'pi-pig: pig not on PATH — run: curl -fsSL https://pi-in-go.dev/install.sh | sh\n' >&2
exit 127

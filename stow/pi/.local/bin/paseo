#!/usr/bin/env bash
# PASEO shim — same canonical npm prefix as the pi shim (~/.npm-global), with the
# fnm default node on PATH so bare (non-interactive) shells can run it.

set -euo pipefail

prefix="${NPM_CONFIG_PREFIX:-$HOME/.npm-global}"
fnm_root="${FNM_DIR:-$HOME/Library/Application Support/fnm}"
[[ -d "$fnm_root/node-versions" ]] || fnm_root="${XDG_DATA_HOME:-$HOME/.local/share}/fnm"

default_node="$(readlink "$fnm_root/aliases/default" 2>/dev/null || true)"
[[ -d "$default_node/bin" ]] && export PATH="$default_node/bin:$PATH"

# Canonical prefix first; ~/.local/lib is the legacy Linux prefix.
for candidate in "$prefix/bin/paseo" "$HOME/.local/lib/node_modules/@getpaseo/cli/bin/paseo"; do
    [[ -x "$candidate" ]] && exec "$candidate" "$@"
done

for p in "$fnm_root"/node-versions/*/installation/bin/paseo; do
    [[ -x "$p" ]] && { export PATH="$(dirname "$p"):$PATH"; exec "$p" "$@"; }
done

echo "paseo: not found — run: npm i -g --prefix ~/.npm-global @getpaseo/cli" >&2
exit 1

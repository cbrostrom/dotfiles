{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "lifecycle": "keep-alive"
    },
    "codebase-memory-mcp": {
      "command": "${HOME}/.local/bin/codebase-memory-mcp",
      "args": [],
      "lifecycle": "keep-alive"
    },
    "paseo-steps-viewer": {
      "command": "node",
      "args": [
        "${HOME}/Projects/personal/paseo-plugins/paseo-steps-viewer/bin/mcp-stdio.ts"
      ],
      "lifecycle": "keep-alive"
    },
    "dockhand-linuxbro": {
      "baseUrl": "http://100.100.1.100:8092/mcp"
    },
    "dockhand-superbro": {
      "baseUrl": "http://100.100.1.50:8080/mcp"
    },
    "cloudflare-dns-superbro": {
      "command": "${HOME}/.pi/agent/scripts/cloudflare-dns-mcp.sh",
      "env": {
        "CLOUDFLARE_ZONE_ID": "d527e17ef5e6ccbeb3b7e48478624ee0"
      },
      "lifecycle": "keep-alive"
    },
    "higgins-writer": {
      "command": "higgins-writer",
      "args": [
        "mcp"
      ],
      "lifecycle": "keep-alive"
    }
  }
}

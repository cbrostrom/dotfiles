#!/usr/bin/env bash
# bash-guard — one pre-shell guard for Pi and Claude Code (bash port).
#
#   bash-guard pi       pi-yaml-hooks tool.before.bash   exit 2 + stderr blocks
#   bash-guard claude   Claude PreToolUse(Bash)          exit 2 + stderr blocks; on allow,
#                                                        hands stdin to `rtk hook claude`
#
# Fast path is pure bash plus one jq call. Anything needing real shell tokenizing
# (a possible `rm`, or `paseo` inside a Paseo agent) and a missing jq are handed to
# bash-guard.py, the reference implementation, so no rule is weaker than before.
# Also here: raw docker on linuxbro (DOCKHAND_GUARD_DISABLE=1 skips), push/publish
# -> push-guard.sh, ssh/wsl -> ssh-guard.sh (only when the command mentions them).

mode="${1:-pi}"
raw="$(cat; printf x)"; raw="${raw%x}"

hooks_dir() { local p; p="$(realpath "${BASH_SOURCE[0]}" 2>/dev/null)" || p="${BASH_SOURCE[0]}"; printf '%s' "${p%/*}"; }

fallback() { exec python3 "$(hooks_dir)/bash-guard.py" "$mode" <<<"$raw"; }

command -v jq >/dev/null 2>&1 || fallback

cwd="" cmd=""
{ IFS= read -r -d '' cwd; IFS= read -r -d '' cmd; } < <(
  printf '%s' "$raw" | jq -j '
    (if type == "object" then . else {} end) as $p
    | def first_str(a): [a | select(. != null and . != "") | tostring] | first // "";
    first_str($p.cwd, ($p.workspace_roots // [])[0]) + "\u0000"
    + first_str(($p.tool_input // {}).command, ($p.tool_args // {}).command, $p.command) + "\u0000"
  ' 2>/dev/null
)

block() {
  printf '%s\n' "$1" >&2
  exit 2
}

delegate() { # script arg
  local path out rc dir="$cwd"
  path="$(hooks_dir)/$1"
  [[ -x "$path" ]] || return 0
  [[ -n "$dir" && -d "$dir" ]] || dir="."
  local t=()
  command -v timeout >/dev/null 2>&1 && t=(timeout 8)
  out="$(cd "$dir" && jq -nc --arg c "$cmd" '{tool_args: {command: $c}}' | "${t[@]}" "$path" "$2" 2>&1 >/dev/null)"
  rc=$?
  [[ $rc -eq 2 ]] && block "${out:-[bash-guard] Blocked by $1.}"
  return 0
}

if [[ -n "$cmd" ]]; then
  # possible rm (allows quotes/backslashes between r and m); python does the tokenizing
  [[ "$cmd" =~ (^|[^[:alnum:]_])r[\'\"\\]*m($|[^[:alnum:]_]) ]] && fallback
  [[ "$cmd" == *find* && "$cmd" == *-delete* ]] && fallback
  [[ -n "${PASEO_AGENT_ID:-}" && "$cmd" == *paseo* ]] && fallback

  if [[ "${DOCKHAND_GUARD_DISABLE:-}" != 1 ]] \
     && [[ "$cmd" =~ (^|[\;\&\|\(\`]|\$\(|sudo[[:space:]]+)[[:space:]]*(docker|docker-compose|podman)([[:space:]]|$) ]]; then
    host="${DOTFILES_FLEET_HOST:-$(hostname)}"; host="${host%%.*}"
    shopt -s nocasematch; [[ "$host" == linuxbro ]] && block "[bash-guard] Docker on linuxbro: use the Dockhand MCP (/skill:dockhand), not raw docker."
  fi

  [[ "$cmd" =~ push|publish|release|merge|upload ]] && delegate push-guard.sh pi
  [[ "$cmd" =~ (^|[^[:alnum:]_])(ssh|wsl|wsl\.exe)($|[^[:alnum:]_]) ]] && delegate ssh-guard.sh bash
fi

if [[ "$mode" == claude ]] && command -v rtk >/dev/null 2>&1; then
  printf '%s' "$raw" | rtk hook claude
  exit $?
fi
exit 0

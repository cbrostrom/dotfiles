#!/usr/bin/env bash
# higgins-tidy — daily Higgins maintenance per project slug, shared by Pi (session.idle)
# and Claude (SessionEnd). Reads .cwd from the hook payload, else $PWD.
# Work runs detached and never blocks the session. Also prunes hook state files
# older than 7 days ($TMPDIR/agent-hooks, $TMPDIR/agent-style-gate).
payload=$(cat 2>/dev/null)
cwd=$(printf '%s' "$payload" | jq -r '.cwd // empty' 2>/dev/null)
[[ -n "$cwd" && -d "$cwd" ]] || cwd="$PWD"
cd "$cwd" 2>/dev/null || exit 0

top=$(git rev-parse --show-toplevel 2>/dev/null)
slug=$(basename "${top:-$cwd}")
tmp="${TMPDIR:-/tmp}"
stamp_dir="$tmp/higgins-tidy"
stamp="$stamp_dir/$slug.stamp"
mkdir -p "$stamp_dir" 2>/dev/null || true
if [[ -f "$stamp" ]]; then
    last=$(cat "$stamp" 2>/dev/null || echo 0)
    [[ "$last" =~ ^[0-9]+$ ]] && (($(date +%s) - last < 86400)) && exit 0
fi
date +%s >"$stamp" 2>/dev/null || true

(
    find "$tmp/agent-hooks" "$tmp/agent-style-gate" -type f -mtime +7 -delete 2>/dev/null
    command -v higgins >/dev/null || exit 0
    higgins digest "$slug" --days 1
    higgins prune "$slug"
    higgins compact "$slug"
    if higgins duckdb status | grep -q '"stale": true'; then
        higgins duckdb rebuild
    fi
) </dev/null >/dev/null 2>&1 &
disown 2>/dev/null
exit 0

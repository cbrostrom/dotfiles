{
  "model": "opus",
  "modelSettings": {
    "claude-fable-5-1": { "effortLevel": "medium" },
    "claude-opus-5-5": { "effortLevel": "low" },
    "claude-sonnet-5-5": { "effortLevel": "low" },
    "claude-haiku-5-5": { "effortLevel": "low" }
  },
  "theme": "dark",
  "outputStyle": "ADHD",
  "enabledPlugins": { "context-mode@context-mode": false, "plannotator@plannotator": true },
  "extraKnownMarketplaces": {
    "plannotator": { "source": { "source": "github", "repo": "backnotprop/plannotator" } }
  },
  "statusLine": { "type": "command", "command": "ccstatusline", "padding": 0, "refreshInterval": 10 },
  "env": {
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "0",
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "1",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "150000",
    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "15000",
    "ENABLE_TOOL_SEARCH": "true",
    "BASH_MAX_OUTPUT_LENGTH": "20000",
    "MAX_MCP_OUTPUT_TOKENS": "15000"
  },
  "disableWorkflows": true,
  "disableClaudeAiConnectors": true,
  "cleanupPeriodDays": 30,
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(npm run:*)",
      "Bash(shopify:*)",
      "Bash(mw list:*)",
      "Bash(mw call atlassian-agent-akqa.*)",
      "Bash(mw call atlassian-agent-fiskars.*)",
      "Bash(mw call shopify-dev-mcp.*)",
      "Bash(mw call codebase-memory-mcp.*)"
    ],
    "deny": [
      "Edit(~/.pi/**)",
      "Edit(~/Vaults/**)",
      "Read(~/.ssh/**)",
      "Read(~/.config/infra-map.md)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/.netrc)",
      "Read(**/.npmrc)",
      "Read(**/.git-credentials)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(~/.pi/agent/auth.json)",
      "Read(~/.pi/agent/configs/.env)",
      "Read(~/.mcporter/tokens/**)",
      "Read(~/.mcporter/credentials.json)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/config)",
      "Read(~/.docker/config.json)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/.netrc)",
      "Edit(**/.npmrc)",
      "Edit(~/.aws/**)",
      "Edit(~/.ssh/**)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(tailscale *)",
      "Bash(git push --force*)",
      "Bash(mcporter)",
      "Bash(mcporter *)",
      "Bash(mw config*)",
      "Bash(mw auth*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "$HOME/.claude/hooks/paseo-attention-style.sh", "timeout": 5 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "$HOME/.claude/hooks/work-scope-guard.sh", "timeout": 10 },
          { "type": "command", "command": "$HOME/.claude/hooks/cc-billing-guard.sh", "timeout": 20 },
          { "type": "command", "command": "$HOME/.agents/hooks/style-gate claude consume", "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "$HOME/.agents/hooks/style-gate claude detect", "timeout": 5 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "$HOME/.agents/hooks/bash-guard claude", "timeout": 15 }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          { "type": "command", "command": "$HOME/.claude/hooks/guard-agent.sh", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          { "type": "command", "command": "$HOME/.claude/hooks/guard-agent.sh release", "timeout": 10 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "$HOME/.agents/hooks/higgins-tidy", "timeout": 10 }
        ]
      }
    ]
  }
}

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dk.brostrom.engram-sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__SYNC_SH__</string>
    </array>

    <!-- Reactive: trigger when either vault directory has any file modified.
         Watching the directory (not specific WAL files) survives SQLite
         wal_checkpoint(TRUNCATE) which destroys+recreates the WAL inode. -->
    <key>WatchPaths</key>
    <array>
        <string>__HOME__/.engram/personal</string>
        <string>__HOME__/.engram/work</string>
    </array>

    <!-- Safety net: every hour catch any missed writes (e.g. laptop slept
         during write, network was down, etc.). -->
    <key>StartInterval</key>
    <integer>3600</integer>

    <!-- Coalesce rapid bursts: if multiple WatchPaths events fire in quick
         succession, run job at most once per 60s window. -->
    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/engram-sync.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/engram-sync.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>

[Unit]
Description=Engram sync hourly safety net
Documentation=https://github.com/Gentleman-Programming/engram

[Timer]
# Equivalent of launchd StartInterval=3600 — hourly safety net.
# Persistent=true catches up missed runs after sleep/shutdown.
OnUnitActiveSec=1h
OnBootSec=5min
Persistent=true
Unit=engram-sync.service

[Install]
WantedBy=timers.target

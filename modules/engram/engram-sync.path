[Unit]
Description=Watch engram WAL files for reactive sync
Documentation=https://github.com/Gentleman-Programming/engram

[Path]
# Equivalent of launchd WatchPaths — fires engram-sync.service on inotify
# events. Watch the vault DIRECTORY (not specific WAL files) so we survive
# SQLite wal_checkpoint(TRUNCATE) which destroys+recreates the WAL inode.
PathChanged=%h/.engram/personal
PathChanged=%h/.engram/work
Unit=engram-sync.service

[Install]
WantedBy=paths.target

#!/usr/bin/env python3
"""session-summarize — zero-token Cursor session summarizer.

Reads the transcript path from today's Inbox session log (written by vault-save.sh),
runs TF-IDF + TextRank locally, and appends a brain-ready summary to the Inbox file.

Usage:
    session-summarize                     # auto-detect today's Brain session log
    session-summarize <transcript.jsonl>  # explicit transcript path
    session-summarize --all               # summarize all unsummarized session logs today
"""

import os
import sys
import json
import re
from datetime import date
from pathlib import Path

HOOKS_DIR = Path.home() / ".cursor" / "hooks"
sys.path.insert(0, str(HOOKS_DIR))

import summarizer as S
import parse_cursor_transcript as P

VAULT_SESSIONS = Path.home() / "Vaults" / "AI" / "sessions"
TODAY = date.today().isoformat()
_YEAR = TODAY[:4]
_MONTH = TODAY[5:7]
# Session files land in sessions/YYYY/MM/ since 2026-07-01 migration
_TODAY_DIR = VAULT_SESSIONS / _YEAR / _MONTH
MARKER = "<!-- summarized -->"


def find_transcript_from_inbox(inbox_file: Path) -> "str | None":
    """Extract transcript path stored in the session log header."""
    try:
        for line in inbox_file.read_text().splitlines():
            if line.startswith("transcript:"):
                return line.split("transcript:", 1)[1].strip()
    except OSError:
        pass
    return None


def already_summarized(inbox_file: Path) -> bool:
    try:
        return MARKER in inbox_file.read_text()
    except OSError:
        return False


def summarize_to_inbox(transcript_path: str, inbox_file: Path) -> None:
    events = P.parse(transcript_path)
    if not events:
        print(f"No events parsed from {transcript_path}", file=sys.stderr)
        return

    goal = P.first_user_goal(events)
    files = P.touched_files(events)
    cmds = P.commands(events)
    last = P.last_assistant_state(events)
    sentences = S.summarize(P.prose(events), k=8)

    lines = [
        "",
        "## Summary",
        f"_{S.backend_name()}_",
        "",
    ]
    if goal:
        lines += [f"**Goal:** {goal}", ""]
    if sentences:
        lines += ["**Key points:**"]
        lines += [f"- {s}" for s in sentences]
        lines.append("")
    if files:
        lines += ["**Files touched:**"]
        lines += [f"- `{f}`" for f in files]
        lines.append("")
    if cmds:
        lines += ["**Commands run:**"]
        lines += [f"- `{c}`" for c in cmds[:10]]
        lines.append("")
    if last:
        lines += [f"**Left off:** {last}", ""]
    lines.append(MARKER)

    summary_block = "\n".join(lines) + "\n"

    # Strip any previous summary section and replace — keeps the log header/stops intact
    existing = inbox_file.read_text() if inbox_file.exists() else ""
    if MARKER in existing:
        existing = existing[:existing.index("\n## Summary")]

    inbox_file.write_text(existing.rstrip("\n") + "\n" + summary_block)
    print(f"Summarized → {inbox_file.name}")


def main():
    args = sys.argv[1:]

    # called directly from hook: session-summarize <transcript.jsonl> <inbox.md>
    # always re-summarize — replaces previous summary with fuller transcript
    if len(args) == 2 and args[0].endswith(".jsonl"):
        transcript, inbox = args[0], Path(args[1])
        summarize_to_inbox(transcript, inbox)
        return

    # explicit transcript only
    if args and not args[0].startswith("--") and args[0].endswith(".jsonl"):
        transcript = args[0]
        inbox = _TODAY_DIR / f"{TODAY}-direct-session.md"
        inbox.parent.mkdir(parents=True, exist_ok=True)
        if not inbox.exists():
            inbox.write_text(f"# Session log: direct — {TODAY}\ntranscript: {transcript}\n\n")
        summarize_to_inbox(transcript, inbox)
        return

    # find today's session logs
    _TODAY_DIR.mkdir(parents=True, exist_ok=True)
    session_logs = sorted(_TODAY_DIR.glob(f"{TODAY}-*-session.md"))
    if not session_logs:
        print(f"No session logs found for {TODAY} in {_TODAY_DIR}")
        return

    target = session_logs if "--all" in args else [session_logs[-1]]

    for inbox_file in target:
        if already_summarized(inbox_file):
            print(f"Already summarized: {inbox_file.name}")
            continue
        transcript = find_transcript_from_inbox(inbox_file)
        if not transcript:
            print(f"No transcript path in {inbox_file.name} — skipping")
            continue
        if not Path(transcript).exists():
            print(f"Transcript not found: {transcript}", file=sys.stderr)
            continue
        summarize_to_inbox(transcript, inbox_file)


if __name__ == "__main__":
    main()

#!/usr/bin/env bash
# Lean Pi launcher for Paseo RPC agents. Normal terminal Pi keeps full discovery.
set -euo pipefail

PI_AGENT_DIR="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}"
# Resolve dotfiles root from this script's location (follows symlinks), so the
# launcher works wherever the checkout lives (~/dotfiles, ~/system/dotfiles).
DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
PROJECT_EXTENSIONS="$HOME/Projects/private/pi-extensions"
INSTALLED_EXTENSIONS="$PI_AGENT_DIR/git/github.com/bybrostrom/pi-extensions"

# Agents run the same installed copy as terminal pi, so uncommitted edits never go
# live by accident. PI_EXTENSIONS_DEV=1 (in Paseo's env) loads the working copy.
if [[ "${PI_EXTENSIONS_DEV:-}" == "1" && -d "$PROJECT_EXTENSIONS/extensions" ]]; then
    PERSONAL_EXTENSIONS="$PROJECT_EXTENSIONS"
elif [[ -d "$INSTALLED_EXTENSIONS/extensions" ]]; then
    PERSONAL_EXTENSIONS="$INSTALLED_EXTENSIONS"
else
    PERSONAL_EXTENSIONS="$PROJECT_EXTENSIONS"
fi

SETTINGS="$PI_AGENT_DIR/settings.json"
command -v jq >/dev/null 2>&1 || { printf 'pi-paseo: jq is required\n' >&2; exit 1; }
[[ -f "$SETTINGS" ]] || { printf 'pi-paseo: missing %s — run setup/pi.sh\n' "$SETTINGS" >&2; exit 1; }

# Packages come from settings.json (same list terminal Pi loads), so installs
# never drift between terminal and Paseo. Skip terminal-only packages: TUI
# managers, interactive permission prompts, and providers workers never use.
# bybrostrom/pi-extensions is skipped here and loaded below from the local checkout.
PASEO_SKIP_PACKAGES=(pi-extension-settings pi-extmgr rpiv-config pi-permission-system
  pi-subagents pi-ollama-cloud pi-blackhole pi-extensions)

# Every listed skill costs its description in every worker's system prompt, so
# shared and package skills are opt-in: new ones stay out until listed here.
PASEO_SKILLS=(call capabilities codebase codebase-memory commit higgins orchestration
  paseo systematic-debugging verification-before-completion fallow tool-restraint
  ask-user context-mode)

extensions=()
skills=("$PI_AGENT_DIR/skills/moli-webfetch")

add_allowed_skills() {
    local root="$1" dir name
    for dir in "$root" "$root"/*/; do
        dir="${dir%/}"
        [[ -f "$dir/SKILL.md" ]] || continue
        name="$(basename "$dir")"
        for allowed in "${PASEO_SKILLS[@]}"; do
            [[ "$name" == "$allowed" ]] && { skills+=("$dir"); break; }
        done
    done
    return 0
}

resolve_entry() {
    local path="$1"
    if [[ -d "$path" ]]; then
        for index in index.ts index.js; do
            [[ -f "$path/$index" ]] && { printf '%s\n' "$path/$index"; return; }
        done
    fi
    printf '%s\n' "$path"
}

while IFS= read -r package; do
    case "$package" in
        npm:*) dir="$PI_AGENT_DIR/npm/node_modules/${package#npm:}" ;;
        git:*) dir="$PI_AGENT_DIR/git/${package#git:}" ;;
        *) continue ;;
    esac
    name="$(basename "$dir")"
    for skip in "${PASEO_SKIP_PACKAGES[@]}"; do
        [[ "$name" == "$skip" ]] && continue 2
    done
    if [[ ! -f "$dir/package.json" ]]; then
        printf 'pi-paseo: missing package: %s\nRun: pi update --all\n' "$package" >&2
        exit 1
    fi
    while IFS= read -r entry; do
        extensions+=("$(resolve_entry "$dir/${entry#./}")")
    done < <(jq -r '.pi.extensions[]? // empty' "$dir/package.json")
    while IFS= read -r entry; do
        add_allowed_skills "$dir/${entry#./}"
    done < <(jq -r '.pi.skills[]? // empty' "$dir/package.json")
done < <(jq -r '.packages[]? | if type == "string" then . else .source // empty end' "$SETTINGS")

extensions+=(
    "$DOTFILES_DIR/stow/pi/.pi/agent/extensions/file-search/index.ts"
    "$PI_AGENT_DIR/extensions/model-policy-guard/index.ts"
)
# Personal extensions gate themselves (extensions/lib/runtime.ts): terminal-only ones
# return early under PASEO_AGENT_ID, so the whole manifest is safe to load.
while IFS= read -r entry; do
    extensions+=("$PERSONAL_EXTENSIONS/${entry#./}")
done < <(jq -r '.pi.extensions[]? // empty' "$PERSONAL_EXTENSIONS/package.json")

add_allowed_skills "$HOME/.agents/skills"

project_root="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || printf '%s' "$PWD")"
for project_skills in "$project_root/.agents/skills" "$project_root/.pi/skills"; do
    [[ -d "$project_skills" ]] && skills+=("$project_skills")
done

# Drop-in dir for Paseo-specific skills (auto-included, no whitelist edit needed):
# create ~/.pi/agent/skills/paseo/<skill-name>/SKILL.md and every NEW Paseo agent
# run through this shim picks it up on next session start. Reload agent does NOT
# re-run this launcher — it resumes the pi process — so new skills need a new agent.
PASEO_SKILLS_DIR="${PASEO_SKILLS_DIR:-$HOME/.pi/agent/skills/paseo}"
[[ -d "$PASEO_SKILLS_DIR" ]] && skills+=("$PASEO_SKILLS_DIR")

extension_args=()
for extension in "${extensions[@]}"; do
    if [[ ! -f "$extension" ]]; then
        printf 'pi-paseo: missing extension: %s\nRun: pi update --all\n' "$extension" >&2
        exit 1
    fi
    extension_args+=(--extension "$extension")
done

skill_args=()
for skill in "${skills[@]}"; do
    [[ -e "$skill" ]] && skill_args+=(--skill "$skill")
done

# Mark RPC children so yaml hooks can scope themselves (e.g. context-mode guard
# dedup: terminal sessions use the enforcer extension instead).
if [[ -x "$HOME/.local/bin/pi" ]]; then
    PI_BIN="$HOME/.local/bin/pi"
elif [[ -x "$DOTFILES_DIR/scripts/pi" ]]; then
    PI_BIN="$DOTFILES_DIR/scripts/pi"
elif pi_path="$(command -v pi 2>/dev/null)"; then
    PI_BIN="$pi_path"
else
    printf 'pi-paseo: pi not found — run: ln -sf "%s/scripts/pi" ~/.local/bin/pi\n' "$DOTFILES_DIR" >&2
    printf '  or: fnm use default && npm install -g @earendil-works/pi-coding-agent\n' >&2
    exit 127
fi
export PI_BIN="$PI_BIN"

# Pi 0.99's built-in MCP extension owns /mcp and reads the --mcp-config file
# Paseo supplies. The launcher disables extension discovery below, so load the
# native MCP/codemode/tool-search trio explicitly.
native_mcp_args=(
    --extension builtin:mcp
    --extension builtin:codemode
    --extension builtin:tool-search
)

# --cursor-no-fast is only accepted by pi builds where the cursor provider is
# registered (Cursor CLI/auth present). On hosts without it (e.g. CloudBro) pi
# rejects the option wholesale ("Unknown option"), so probe support first.
cursor_fast_args=()
if [[ -f "$PI_BIN" ]] && "$PI_BIN" --help 2>&1 | grep -q -- --cursor-no-fast; then
    cursor_fast_args+=(--cursor-no-fast)
fi

# RPC interpreter: rate-shapes pi's message_update delta stream into
# block-complete content so Paseo's timeline provider never closes items on
# markdown-unsafe boundaries (fragment `**→` cards, partial thinking cards).
# Terminal / non-RPC invocations exit untouched via exec passthrough in the shim.
# PI_RPC_STREAM_MS=0 (default) = block-complete only: no partial flushes, no
# half-rendered cards for ANY provider (cursor/copilot/opencode/codex). Set an
# explicit value to re-enable faster partial streaming if so desired.
INTERPRETER="$PERSONAL_EXTENSIONS/scripts/pi-rpc-interpreter.mjs"
if [[ "${PI_PASEO_NO_INTERPRETER:-}" != "1" && -f "$INTERPRETER" ]] && command -v node >/dev/null 2>&1; then
    export PI_RPC_CHILD=1
    export PI_RPC_STREAM_MS="${PI_RPC_STREAM_MS:-0}"
    exec node "$INTERPRETER" \
        --no-extensions \
        --no-skills \
        --exclude-tools powershell,grep,find,ls \
        "${cursor_fast_args[@]}" \
        "${native_mcp_args[@]}" \
        "${extension_args[@]}" \
        "${skill_args[@]}" \
        "$@"
fi

export PI_RPC_CHILD=1
exec "$PI_BIN" \
    --no-extensions \
    --no-skills \
    --exclude-tools powershell,grep,find,ls \
    "${cursor_fast_args[@]}" \
    "${native_mcp_args[@]}" \
    "${extension_args[@]}" \
    "${skill_args[@]}" \
    "$@"

#!/usr/bin/env bash
# kb-load — shared vault context loader
# Usage: kb-load [--format=cursor|claude] [slug]
# Cursor (default): writes to ~/.cursor/rules/session-brain.mdc
# Claude: stdout for additional_context injection
set -uo pipefail

VAULT_AI="${VAULT_AI:-$HOME/Vaults/Higgins/AI}"
KB="$VAULT_AI/tools/kb"
[[ -x "$KB" ]] || exit 0

# ── Parse args ──
FORMAT="cursor"
SLUG=""
for arg in "$@"; do
  case "$arg" in
    --format=*) FORMAT="${arg#*=}" ;;
    -*) ;; # skip other flags
    *) SLUG="$arg" ;;
  esac
done

# ── Slug resolution ──
if [[ -z "$SLUG" ]]; then
  if git rev-parse --git-dir >/dev/null 2>&1; then
    SLUG="$(basename "$(git rev-parse --show-toplevel 2>/dev/null)")"
  else
    SLUG="$(basename "$PWD")"
  fi
fi

case "$SLUG" in
  empty-window|""|"$USER"|"Users-$USER"|"home") SLUG="personal" ;;
esac

# ── Load context ──
output="$(VAULT_AI="$VAULT_AI" "$KB" load "$SLUG" 2>/dev/null)" || exit 0
[[ -z "$output" ]] && exit 0

# ── Dispatch by format ──
case "$FORMAT" in
  cursor)
    MAX_CHARS="${KB_LOAD_MAX_CHARS:-6000}"
    if [[ "${#output}" -gt "$MAX_CHARS" ]]; then
      output="${output:0:$MAX_CHARS}

...(truncated — kb load --full for more)"
    fi
    OUT_FILE="$HOME/.cursor/rules/session-brain.mdc"
    mkdir -p "$(dirname "$OUT_FILE")"
    python3 - "$OUT_FILE" "$output" <<'PY'
import sys, pathlib
rule_path, content = pathlib.Path(sys.argv[1]), sys.argv[2]
rule_path.write_text(
    "---\ndescription: Session brain (kb load — auto-generated)\nalwaysApply: false\n---\n\n"
    + content + "\n"
)
PY
    ;;
  claude)
    echo "=== PROJECT BRAIN LOADED ==="
    echo "$output"
    echo "=== END PROJECT BRAIN ==="
    ;;
  *)
    echo "kb-load: unknown format '$FORMAT'" >&2; exit 1 ;;
esac

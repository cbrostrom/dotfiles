#!/usr/bin/env python3
"""kb-mcp — MCP server wrapping the kb CLI for on-demand vault access.
Also provides tools for querying the personal vault (Me/)."""

import os
import sys
import subprocess
from pathlib import Path

from mcp.server.fastmcp import FastMCP

mcp = FastMCP(
    "kb",
    instructions="On-demand access to the Higgins vaults. Query AI project context and personal notes.",
)

KB = str(Path.home() / "dotfiles" / "scripts" / "kb")
VAULT_AI = os.environ.get("VAULT_AI", str(Path.home() / "Vaults" / "Higgins" / "AI"))
VAULT_ME = os.environ.get("VAULT_ME", str(Path.home() / "Vaults" / "Higgins" / "Me"))


def _run_kb(*args: str) -> str:
    """Run kb CLI and return stdout."""
    env = {**os.environ, "VAULT_AI": VAULT_AI}
    try:
        r = subprocess.run(
            [KB, *args],
            capture_output=True,
            text=True,
            timeout=30,
            env=env,
        )
        if r.returncode != 0:
            return f"Error: {r.stderr.strip()}" if r.stderr else "Error: command failed"
        return r.stdout.strip()
    except FileNotFoundError:
        return f"Error: kb not found at {KB}"
    except subprocess.TimeoutExpired:
        return "Error: command timed out"


def _me_path(rel: str = "") -> Path:
    """Resolve a path relative to the personal vault."""
    base = Path(VAULT_ME)
    if not rel:
        return base
    return base / rel


@mcp.tool()
def kb_load(slug: str = "", full: bool = False) -> str:
    """Load vault context for a project slug. Returns personal context + project brain.
    If no slug given, resolves from cwd. Use full=true for full preferences + module gotchas."""
    args = ["load"]
    if full:
        args.append("--full")
    if slug:
        args.append(slug)
    return _run_kb(*args)


@mcp.tool()
def kb_status(slug: str = "") -> str:
    """Show dashboard for a project: modified time, file sizes, session count."""
    args = ["status"]
    if slug:
        args.append(slug)
    return _run_kb(*args)


@mcp.tool()
def kb_search(query: str, full: bool = False) -> str:
    """Search across vault content. Returns kb load output (personal + modules + matching projects).
    For broad search, use kb_load. This resolves slug from the query and loads it."""
    return _run_kb("load", query) if not full else _run_kb("load", "--full", query)


@mcp.tool()
def kb_current(slug: str = "", text: str = "") -> str:
    """Read or update current.md. No text = read. With text = append a bullet."""
    args = ["current"]
    if slug:
        args.insert(1, slug)
    if text:
        args.append(text)
    return _run_kb(*args)


@mcp.tool()
def kb_next(slug: str = "", text: str = "") -> str:
    """Read or add action items. No text = read active items. With text = add item."""
    args = ["next"]
    if slug:
        args.insert(1, slug)
    if text:
        args.append(text)
    return _run_kb(*args)


@mcp.tool()
def kb_gotcha(slug: str = "", text: str = "") -> str:
    """Read or log a gotcha. No text = read gotchas. With text = append."""
    args = ["gotcha"]
    if slug:
        args.insert(1, slug)
    if text:
        args.append(text)
    return _run_kb(*args)


@mcp.tool()
def kb_done(slug: str = "", substr: str = "") -> str:
    """Mark an item done in next.md. Provide substring to match."""
    args = ["done"]
    if slug:
        args.insert(1, slug)
    if substr:
        args.append(substr)
    return _run_kb(*args)


@mcp.tool()
def kb_save(slug: str = "", text: str = "") -> str:
    """Save session summary to history/."""
    args = ["save"]
    if slug:
        args.insert(1, slug)
    if text:
        args.append(text)
    return _run_kb(*args)


@mcp.tool()
def kb_prune(slug: str = "") -> str:
    """Move [done:] items from next.md to history/."""
    args = ["prune"]
    if slug:
        args.append(slug)
    return _run_kb(*args)


@mcp.tool()
def kb_compact(slug: str = "", cap: int = 5) -> str:
    """Cap current.md at cap bullets; overflow moves to history/."""
    args = ["compact"]
    if slug:
        args.append(slug)
    return _run_kb(*args)


@mcp.tool()
def kb_lint() -> str:
    """Validate the vault tree against _schema/. Returns errors and warnings."""
    return _run_kb("lint")


@mcp.tool()
def kb_resolve() -> str:
    """Resolve the active slug from cwd/args. Useful for discovering what project you're in."""
    return _run_kb("slug")


@mcp.tool()
def kb_map(subcommand: str = "help") -> str:
    """Project registry + CODEBASE generator. Subcommands: help, list, codebase, etc."""
    return _run_kb("map", subcommand)


# ── Personal vault (Me/) tools ──────────────────────────────────────────────


@mcp.tool()
def me_list(folder: str = "") -> str:
    """List notes and subfolders in the personal vault. Defaults to root.
    Use folder='Personal' to list personal notes, folder='Work' for work, etc."""
    p = _me_path(folder)
    if not p.is_dir():
        return f"Error: folder not found: {p}"
    
    entries = []
    for item in sorted(p.iterdir()):
        if item.name.startswith("."):
            continue
        if item.is_dir():
            count = sum(1 for _ in item.rglob("*.md"))
            entries.append(f"  {item.name}/  ({count} notes)")
        elif item.suffix == ".md":
            entries.append(f"  {item.name}")
    
    if not entries:
        return f"Empty folder: {folder or 'root'}"
    
    return f"=== {folder or 'Me/'} ===\n" + "\n".join(entries)


@mcp.tool()
def me_read(path: str) -> str:
    """Read a note from the personal vault. Path is relative to Me/.
    Example: 'Personal/Familie/Psyk.md' or 'Work/Projects.md'."""
    p = _me_path(path)
    if not p.is_file():
        # Try adding .md extension
        p = _me_path(path + ".md")
    if not p.is_file():
        return f"Error: file not found: {path}"
    
    try:
        content = p.read_text(encoding="utf-8")
        # Truncate if very long
        if len(content) > 8000:
            lines = content.splitlines()
            truncated = "\n".join(lines[:200])
            return f"{truncated}\n\n... ({len(lines) - 200} more lines)"
        return content
    except Exception as e:
        return f"Error reading {path}: {e}"


@mcp.tool()
def me_search(query: str, folder: str = "", limit: int = 10) -> str:
    """Search across personal notes for text matches.
    Returns file paths and matching lines. Use folder to scope search."""
    search_dir = _me_path(folder)
    if not search_dir.is_dir():
        return f"Error: folder not found: {search_dir}"
    
    results = []
    query_lower = query.lower()
    
    for md_file in sorted(search_dir.rglob("*.md")):
        if len(results) >= limit:
            break
        try:
            content = md_file.read_text(encoding="utf-8")
            for i, line in enumerate(content.splitlines(), 1):
                if query_lower in line.lower():
                    rel = md_file.relative_to(Path(VAULT_ME))
                    results.append(f"{rel}:{i}: {line.strip()[:100]}")
                    if len(results) >= limit:
                        break
        except Exception:
            continue
    
    if not results:
        return f"No matches for '{query}' in {folder or 'Me/'}"
    
    return f"=== Search: '{query}' ({len(results)} matches) ===\n" + "\n".join(results)


@mcp.tool()
def me_folders() -> str:
    """List the folder structure of the personal vault."""
    root = Path(VAULT_ME)
    if not root.is_dir():
        return f"Error: vault not found: {VAULT_ME}"
    
    folders = []
    for item in sorted(root.iterdir()):
        if item.name.startswith(".") or item.name in ("trash", "Attachments"):
            continue
        if item.is_dir():
            count = sum(1 for _ in item.rglob("*.md"))
            folders.append(f"{item.name}/  ({count} notes)")
    
    return "=== Personal Vault Structure ===\n" + "\n".join(folders)


@mcp.tool()
def me_recent(limit: int = 10) -> str:
    """Show recently modified notes in the personal vault."""
    root = Path(VAULT_ME)
    if not root.is_dir():
        return f"Error: vault not found: {VAULT_ME}"
    
    files = []
    for md_file in root.rglob("*.md"):
        try:
            mtime = md_file.stat().st_mtime
            files.append((mtime, md_file))
        except Exception:
            continue
    
    # Sort by modification time, newest first
    files.sort(key=lambda x: x[0], reverse=True)
    
    results = []
    import datetime
    for mtime, md_file in files[:limit]:
        rel = md_file.relative_to(root)
        dt = datetime.datetime.fromtimestamp(mtime).strftime("%Y-%m-%d %H:%M")
        results.append(f"  {rel}  ({dt})")
    
    return "=== Recently Modified ===\n" + "\n".join(results)


if __name__ == "__main__":
    mcp.run()

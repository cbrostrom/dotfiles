<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.christian.paseo-watchdog</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/Christian.Brostrom/dotfiles/scripts/paseo-watchdog.sh</string>
    </array>
    <key>StartInterval</key>
    <integer>30</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>EnvironmentVariables</key>
    <dict>
        <key>THRESHOLD_PASEO_WATCHDOG</key>
        <string>900</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/paseo-watchdog.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/paseo-watchdog.log</string>
</dict>
</plist>

# ~/.config/dotfiles/modules.conf
#
# Per-machine module overrides. Copy to ~/.config/dotfiles/modules.conf (gitignored).
# Repo-wide defaults live in ~/dotfiles/modules.conf (tracked) — this file wins.
#
# Format: one module name per line.
#   bare name      → explicitly enable (overrides MODULE_DEFAULT_ENABLED=false)
#   !name          → explicitly disable (overrides MODULE_DEFAULT_ENABLED=true)
#   # comment      → ignored
#
# See `bootstrap.sh --list` for available modules.

# --- Common per-host opt-ins ---

# Bitwarden CLI (rbw) — env-injected secrets. Enable on machines with vault access.
# rbw

# Herdr terminal multiplexer — agent-aware session persistence + SSH remote attach.
# Enable when Cursor CLI is not available (servers, WSL).
# herdr

# PI coding agent daily-driver config. Enable on machines running PI.
# pi

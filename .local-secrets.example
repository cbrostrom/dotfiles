# =============================================================================
# LOCAL SECRETS TEMPLATE
# =============================================================================
# Copy this file to ~/.local-secrets and add your actual tokens
# 
# NEVER commit the actual ~/.local-secrets file!
# This is just a template to show what secrets you might need.

# GitHub Token (for MCP and CLI tools)
# Generate at: https://github.com/settings/tokens
# Required scopes: repo (full access)
# export GITHUB_PERSONAL_ACCESS_TOKEN="ghp_YOUR_TOKEN_HERE"

# OpenRouter (used by Codex CLI and Claude Code)
# Get your key at: https://openrouter.ai/keys
# OPENROUTER_API_KEY="sk-or-..."

# Other API keys and secrets
# OPENAI_API_KEY="sk-..."
# ANTHROPIC_API_KEY="sk-ant-..."
# AWS_ACCESS_KEY_ID="..."
# AWS_SECRET_ACCESS_KEY="..."

# Obsidian Local REST API (ob CLI + direct Bash calls)
# Find in Obsidian → Settings → Local REST API
# export OBSIDIAN_API_KEY="your-key-here"
# export OBSIDIAN_PORT="27124"       # default, only set if changed
# export OBSIDIAN_HOST=""            # auto-detected: localhost (macOS/Linux) or WSL gateway

